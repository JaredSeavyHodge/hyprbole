#!/bin/bash

# hyprbole:summary=Refresh btop theme symlink

set -euo pipefail

HYPRBOLE_CONFIG_PATH="${HYPRBOLE_CONFIG_PATH:-$HOME/.config/hyprbole}"
BTOP_THEME="$HYPRBOLE_CONFIG_PATH/current/theme/btop.theme"

mkdir -p "$HOME/.config/btop/themes"

if [[ -f $BTOP_THEME ]]; then
  ln -sfn "$BTOP_THEME" "$HOME/.config/btop/themes/current.theme"
fi
