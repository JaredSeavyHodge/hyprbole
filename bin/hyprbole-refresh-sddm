#!/bin/bash

# hyprbole:summary=Refresh SDDM wallpaper assets

set -euo pipefail

HYPRBOLE_CONFIG_PATH="${HYPRBOLE_CONFIG_PATH:-$HOME/.config/hyprbole}"
SDDM_THEME_PATH="/usr/share/sddm/themes/hyprbole"
WALLPAPER_PATH="$HYPRBOLE_CONFIG_PATH/current/background"
CURRENT_THEME_NAME_PATH="$HYPRBOLE_CONFIG_PATH/current/theme-name"
CURRENT_THEME_COLORS_PATH=""
sudo_args=()

current_theme_name="default"
accent="#9bb1ff"
foreground="#e7e9ee"
muted="#8b91a0"

case "${1:-}" in
  --noninteractive)
    sudo_args=(-n)
    ;;
  "")
    ;;
  *)
    printf 'Usage: hyprbole-refresh-sddm [--noninteractive]\n' >&2
    exit 1
    ;;
esac

run_sudo() {
  sudo "${sudo_args[@]}" "$@"
}

read_theme_color() {
  local key="$1"
  local path="$2"

  sed -n "s/^${key}[[:space:]]*=[[:space:]]*\"\([^\"]*\)\"/\1/p" "$path"
}

if [[ -f $CURRENT_THEME_NAME_PATH ]]; then
  current_theme_name="$(cat "$CURRENT_THEME_NAME_PATH")"
fi

CURRENT_THEME_COLORS_PATH="$HYPRBOLE_CONFIG_PATH/current/theme/colors.toml"

if [[ -f $CURRENT_THEME_COLORS_PATH ]]; then
  accent="$(read_theme_color accent "$CURRENT_THEME_COLORS_PATH")"
  foreground="$(read_theme_color foreground "$CURRENT_THEME_COLORS_PATH")"
  muted="$(read_theme_color color8 "$CURRENT_THEME_COLORS_PATH")"

  [[ -n $accent ]] || accent="#9bb1ff"
  [[ -n $foreground ]] || foreground="#e7e9ee"
  [[ -n $muted ]] || muted="$foreground"
fi

if ! command -v sddm >/dev/null 2>&1; then
  exit 0
fi

[[ -d $SDDM_THEME_PATH ]] || exit 0
[[ -f $WALLPAPER_PATH ]] || exit 0

run_sudo cp "$(readlink -f "$WALLPAPER_PATH")" "$SDDM_THEME_PATH/background.jpg"
run_sudo tee "$SDDM_THEME_PATH/theme.conf" >/dev/null <<EOF
[General]
background=background.jpg
backgroundBlur=background-blur.jpg
Accent=$accent
Foreground=$foreground
Muted=$muted
EOF

if command -v magick >/dev/null 2>&1; then
  run_sudo magick "$SDDM_THEME_PATH/background.jpg" -resize 1920x1080^ -gravity center -extent 1920x1080 -blur 0x18 "$SDDM_THEME_PATH/background-blur.jpg"
elif command -v convert >/dev/null 2>&1; then
  run_sudo convert "$SDDM_THEME_PATH/background.jpg" -resize 1920x1080^ -gravity center -extent 1920x1080 -blur 0x18 "$SDDM_THEME_PATH/background-blur.jpg"
else
  run_sudo cp "$SDDM_THEME_PATH/background.jpg" "$SDDM_THEME_PATH/background-blur.jpg"
fi
