#!/bin/bash

# hyprbole:summary=Restart waybar cleanly

set -euo pipefail

config_path="$HOME/.config/waybar/config.jsonc"
style_path="$HOME/.config/waybar/style.css"
log_path="${XDG_STATE_HOME:-$HOME/.local/state}/hyprbole/waybar.log"

mkdir -p "$(dirname "$log_path")"

systemctl --user stop waybar.service >/dev/null 2>&1 || true

if systemctl --user list-unit-files hyprbole-waybar.service >/dev/null 2>&1 || systemctl --user status hyprbole-waybar.service >/dev/null 2>&1; then
  systemctl --user stop hyprbole-waybar.service >/dev/null 2>&1 || true
  for _ in {1..20}; do
    if ! systemctl --user status hyprbole-waybar.service >/dev/null 2>&1; then
      break
    fi
    sleep 0.1
  done
fi

pkill -x waybar >/dev/null 2>&1 || true

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v uwsm >/dev/null 2>&1; then
  exec uwsm app -s b -t service -a waybar -u hyprbole-waybar.service -d "Hyprbole Waybar" -- \
    bash -lc 'exec waybar -c "$1" -s "$2" >"$3" 2>&1' hyprbole-waybar "$config_path" "$style_path" "$log_path"
fi

nohup waybar -c "$config_path" -s "$style_path" >"$log_path" 2>&1 </dev/null & disown
