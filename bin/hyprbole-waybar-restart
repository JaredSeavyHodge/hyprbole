#!/bin/bash

# hyprbole:summary=Restart waybar cleanly

set -euo pipefail

config_path="$HOME/.config/waybar/config.jsonc"
style_path="$HOME/.config/waybar/style.css"
log_path="${XDG_STATE_HOME:-$HOME/.local/state}/hyprbole/waybar.log"

mkdir -p "$(dirname "$log_path")"

pkill -x waybar >/dev/null 2>&1 || true
waybar -c "$config_path" -s "$style_path" >"$log_path" 2>&1 & disown
