#!/bin/bash

# hyprbole:summary=Set up browser theme policy symlinks

set -euo pipefail

HYPRBOLE_CONFIG_PATH="${HYPRBOLE_CONFIG_PATH:-$HOME/.config/hyprbole}"
USER_BROWSER_POLICY="$HYPRBOLE_CONFIG_PATH/current/browser-policy.json"

mkdir -p "$(dirname "$USER_BROWSER_POLICY")"
if [[ ! -f $USER_BROWSER_POLICY ]]; then
  printf '{"BrowserThemeColor":"#1c2027","BrowserColorScheme":"device"}\n' >"$USER_BROWSER_POLICY"
fi

POLICY_DIR=/etc/brave/policies/managed

sudo install -d "$POLICY_DIR"
sudo rm -f "$POLICY_DIR/color.json"
sudo ln -s "$USER_BROWSER_POLICY" "$POLICY_DIR/color.json"

hyprbole-refresh-browser
