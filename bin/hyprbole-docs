#!/bin/bash

# hyprbole:summary=Generate and open the Hyprbole user guide
# hyprbole:args=[--no-open]

set -euo pipefail

HYPRBOLE_PATH="${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}"
HYPRBOLE_CONFIG_PATH="${HYPRBOLE_CONFIG_PATH:-$HOME/.config/hyprbole}"
DOCS_SOURCE_DIR="$HYPRBOLE_PATH/docs/user-guide/src"
DOCS_OUTPUT_DIR="$HYPRBOLE_CONFIG_PATH/docs"
DOCS_INDEX="$DOCS_OUTPUT_DIR/index.html"
DOCS_LOGO_SOURCE="$HYPRBOLE_PATH/assets/logo/hyprbole-logo.svg"
DOCS_LOGO_OUTPUT="$DOCS_OUTPUT_DIR/assets/logo/hyprbole-logo.svg"
THEME_COLORS_PATH="$HYPRBOLE_CONFIG_PATH/current/theme/colors.toml"
OPEN_DOCS=1

DOCS_NAV=(
  "Welcome:index.md"
  "Install:install.md"
  "First Boot:first-boot.md"
  "Commands:commands.md"
  "Terminal:terminal.md"
  "Hyprland:hyprland-config.md"
  "App Launcher:walker.md"
  "Neovim:neovim.md"
  "Themes:themes.md"
  "Browser:browser.md"
  "Keybinds:keybinds.md"
  "Packages:packages.md"
  "Snapshots:snapshots.md"
  "Keyring:keyring.md"
  "Troubleshooting:troubleshooting.md"
)

while (( $# > 0 )); do
  case "$1" in
    --no-open)
      OPEN_DOCS=0
      ;;
    *)
      printf 'Usage: hyprbole-docs [--no-open]\n' >&2
      exit 1
      ;;
  esac
  shift
done

json_string() {
  jq -Rn --arg value "$1" '$value'
}

theme_color() {
  local key="$1"

  [[ -f $THEME_COLORS_PATH ]] || return 1
  sed -n "s/^[[:space:]]*${key}[[:space:]]*=[[:space:]]*\"\(#[0-9A-Fa-f]\{6\}\)\".*/\1/p" "$THEME_COLORS_PATH" | head -n 1
}

hex_to_rgb_triplet() {
  local hex="${1#\#}"

  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || return 1
  printf '%d, %d, %d\n' "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}"
}

color_luma() {
  local hex="${1#\#}"
  local r
  local g
  local b

  [[ $hex =~ ^[0-9A-Fa-f]{6}$ ]] || return 1
  r=$((16#${hex:0:2}))
  g=$((16#${hex:2:2}))
  b=$((16#${hex:4:2}))
  printf '%d\n' $(((r * 299 + g * 587 + b * 114) / 1000))
}

darkest_theme_color() {
  local key
  local color
  local luma
  local best_color=""
  local best_luma=999

  for key in background color0 color8 selection_foreground active_tab_background accent color1 color2 color3 color4 color5 color6 color7 color9 color10 color11 color12 color13 color14 color15 foreground; do
    color="$(theme_color "$key" || true)"
    [[ -n $color ]] || continue
    luma="$(color_luma "$color" || true)"
    [[ -n $luma ]] || continue
    if (( luma < best_luma )); then
      best_luma=$luma
      best_color="$color"
    fi
  done

  [[ -n $best_color ]] || return 1
  printf '%s\n' "$best_color"
}

emit_theme_css() {
  local base_color
  local base_rgb
  local accent_color
  local accent_rgb
  local accent2_color
  local accent2_rgb

  base_color="$(darkest_theme_color || true)"
  accent_color="$(theme_color accent || true)"
  accent2_color="$(theme_color color6 || true)"

  base_rgb="$(hex_to_rgb_triplet "${base_color:-#070910}" || printf '7, 9, 16\n')"
  accent_rgb="$(hex_to_rgb_triplet "${accent_color:-#9bb1ff}" || printf '155, 177, 255\n')"
  accent2_rgb="$(hex_to_rgb_triplet "${accent2_color:-#78e0c5}" || printf '120, 224, 197\n')"

  printf '    :root {\n'
  printf '      --theme-darkest: %s;\n' "${base_color:-#070910}"
  printf '      --theme-darkest-rgb: %s;\n' "$base_rgb"
  printf '      --theme-accent: %s;\n' "${accent_color:-#9bb1ff}"
  printf '      --theme-accent-rgb: %s;\n' "$accent_rgb"
  printf '      --theme-accent-2: %s;\n' "${accent2_color:-#78e0c5}"
  printf '      --theme-accent-2-rgb: %s;\n' "$accent2_rgb"
  printf '    }\n'
}

emit_docs_json() {
  local entry
  local title
  local file
  local id
  local markdown_json
  local first=1

  printf '['
  for entry in "${DOCS_NAV[@]}"; do
    title="${entry%%:*}"
    file="${entry#*:}"
    id="${file%.md}"

    if [[ ! -f $DOCS_SOURCE_DIR/$file ]]; then
      printf 'missing guide page: %s\n' "$DOCS_SOURCE_DIR/$file" >&2
      exit 1
    fi

    markdown_json="$(jq -Rs . <"$DOCS_SOURCE_DIR/$file")"

    if (( first == 0 )); then
      printf ','
    fi
    first=0

    printf '{"id":%s,"title":%s,"path":%s,"markdown":%s}' \
      "$(json_string "$id")" \
      "$(json_string "$title")" \
      "$(json_string "$file")" \
      "$markdown_json"
  done
  printf ']'
}

if ! command -v jq >/dev/null 2>&1; then
  printf 'missing required command: jq\n' >&2
  exit 1
fi

if [[ ! -d $DOCS_SOURCE_DIR ]]; then
  printf 'missing Hyprbole docs source: %s\n' "$DOCS_SOURCE_DIR" >&2
  exit 1
fi

if [[ ! -f $DOCS_LOGO_SOURCE ]]; then
  printf 'missing Hyprbole docs logo: %s\n' "$DOCS_LOGO_SOURCE" >&2
  exit 1
fi

mkdir -p "$DOCS_OUTPUT_DIR/assets/logo"
cp "$DOCS_LOGO_SOURCE" "$DOCS_LOGO_OUTPUT"

