        <button id="menuButton" type="button">Guide Menu</button>
        <span>hyprbole guide</span>
      </div>
      <div class="layout">
        <main>
          <div class="doc-meta" id="meta"></div>
          <article class="doc" id="content"></article>
        </main>
        <aside class="toc" id="toc" aria-label="Page sections"></aside>
      </div>
    </div>
  </div>
  <script>
    const docs =
HTML
  emit_docs_json
  cat <<'HTML'
;

    const nav = document.getElementById('nav');
    const content = document.getElementById('content');
    const meta = document.getElementById('meta');
    const toc = document.getElementById('toc');
    const search = document.getElementById('search');
    const sidebar = document.getElementById('sidebar');
    const menuButton = document.getElementById('menuButton');
    let currentId = docs[0]?.id || 'index';
    let currentHeadings = [];

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function escapeRegExp(value) {
      return value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }

    function slugify(value) {
      return value.toLowerCase()
        .replace(/`([^`]+)`/g, '$1')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-') || 'section';
    }

    function inlineMarkdown(value) {
      let html = escapeHtml(value);
      html = html.replace(/`([^`]+)`/g, '<code>$1</code>');
      html = html.replace(/\[([^\]]+)\]\(([^)]+)\)/g, (_, label, url) => {
        const safeUrl = escapeHtml(url);
        return `<a href="${safeUrl}">${label}</a>`;
      });
      html = html.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      html = html.replace(/(^|\s)_([^_]+)_(?=\s|$|[.,!?])/g, '$1<em>$2</em>');
      return html;
    }

    function tableCells(line) {
      return line.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map(cell => cell.trim());
    }

    function isTableSeparator(line) {
      return /^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)+\|?\s*$/.test(line);
    }

    function renderTable(lines) {
      const header = tableCells(lines[0]);
      const rows = lines.slice(2).map(tableCells);
      return `<div class="table-wrap"><table><thead><tr>${header.map(cell => `<th>${inlineMarkdown(cell)}</th>`).join('')}</tr></thead><tbody>${rows.map(row => `<tr>${row.map(cell => `<td>${inlineMarkdown(cell)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;
    }

    function renderCodeBlock(language, code) {
      const label = language || 'text';
      return `<div class="codeblock"><div class="codebar"><span>${escapeHtml(label)}</span><button class="copy-code" type="button">copy</button></div><pre><code>${escapeHtml(code.replace(/\n$/, ''))}</code></pre></div>`;
    }

    function renderImage(alt, url) {
      return `<figure class="doc-image"><img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}"></figure>`;
    }

    function renderMarkdown(markdown) {
      const lines = markdown.replace(/\r\n/g, '\n').split('\n');
      const output = [];
      const headings = [];
      let i = 0;

      while (i < lines.length) {
        const line = lines[i];

        if (!line.trim()) {
          i += 1;
          continue;
        }

        const fence = line.match(/^```\s*([^`]*)\s*$/);
        if (fence) {
          const code = [];
          i += 1;
          while (i < lines.length && !/^```\s*$/.test(lines[i])) {
            code.push(lines[i]);
            i += 1;
          }
          if (i < lines.length) i += 1;
          output.push(renderCodeBlock(fence[1].trim(), code.join('\n')));
          continue;
        }

        const heading = line.match(/^(#{1,3})\s+(.+)$/);
        if (heading) {
          const level = heading[1].length;
          const text = heading[2].trim();
          let id = slugify(text);
          let suffix = 2;
          while (headings.some(existing => existing.id === id)) {
            id = `${slugify(text)}-${suffix}`;
            suffix += 1;
          }
          headings.push({ level, text, id });
          const previous = output[output.length - 1] || '';
          const className = level === 3 && /^<h1\b/.test(previous) ? ' class="subtitle"' : '';
          output.push(`<h${level}${className} id="${id}">${inlineMarkdown(text)}</h${level}>`);
          i += 1;
          continue;
        }

        const image = line.trim().match(/^!\[([^\]]*)\]\(([^)]+)\)$/);
        if (image) {
          output.push(renderImage(image[1], image[2]));
          i += 1;
          continue;
        }

        if (line.trim().startsWith('|') && i + 1 < lines.length && isTableSeparator(lines[i + 1])) {
          const table = [line, lines[i + 1]];
          i += 2;
          while (i < lines.length && lines[i].trim().startsWith('|')) {
            table.push(lines[i]);
            i += 1;
          }
          output.push(renderTable(table));
          continue;
        }

        if (/^\s*-\s+/.test(line)) {
          const items = [];
          while (i < lines.length && /^\s*-\s+/.test(lines[i])) {
            items.push(lines[i].replace(/^\s*-\s+/, ''));
            i += 1;
          }
          output.push(`<ul>${items.map(item => `<li>${inlineMarkdown(item)}</li>`).join('')}</ul>`);
          continue;
        }

        const paragraph = [line.trim()];
        i += 1;
        while (i < lines.length && lines[i].trim() && !/^#{1,3}\s+/.test(lines[i]) && !/^```/.test(lines[i]) && !/^\s*-\s+/.test(lines[i]) && !lines[i].trim().startsWith('|') && !/^!\[[^\]]*\]\([^)]+\)$/.test(lines[i].trim())) {
          paragraph.push(lines[i].trim());
          i += 1;
        }
        output.push(`<p>${inlineMarkdown(paragraph.join(' '))}</p>`);
      }

      return { html: output.join('\n'), headings };
    }

    function renderNav(activeId = currentId, filter = '') {
      const query = filter.trim().toLowerCase();
      nav.innerHTML = docs
        .filter(doc => !query || `${doc.title}\n${doc.markdown}`.toLowerCase().includes(query))
        .map(doc => `<button type="button" class="${doc.id === activeId ? 'active' : ''}" data-page="${doc.id}">${escapeHtml(doc.title)}</button>`)
        .join('') || '<p class="empty">No pages match.</p>';
    }

    function renderToc() {
      const sections = currentHeadings.filter(heading => heading.level > 1);
      if (!sections.length) {
        toc.innerHTML = '';
        return;
      }
      toc.innerHTML = `<p class="toc-title">On This Page</p>${sections.map(heading => `<button type="button" class="level-${heading.level}" data-anchor="${heading.id}">${escapeHtml(heading.text.replace(/`/g, ''))}</button>`).join('')}`;
    }

    function setPage(id, push = true) {
      const doc = docs.find(item => item.id === id) || docs[0];
      currentId = doc.id;
      const rendered = renderMarkdown(doc.markdown);
      currentHeadings = rendered.headings;
      document.title = `${doc.title} - hyprbole guide`;
      meta.innerHTML = `<span class="pill">${escapeHtml(doc.path)}</span><span class="pill">local guide</span>`;
      content.innerHTML = rendered.html;
      renderNav(currentId, search.value);
      renderToc();
      if (push) history.replaceState(null, '', `#${doc.id}`);
      sidebar.classList.remove('open');
      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    function excerpt(markdown, query) {
      const text = markdown.replace(/```[\s\S]*?```/g, ' ').replace(/[#|`*_\-[\]()]/g, ' ').replace(/\s+/g, ' ').trim();
      const lower = text.toLowerCase();
      const index = lower.indexOf(query.toLowerCase());
      const start = Math.max(0, index - 90);
      const slice = text.slice(start, start + 220);
      if (!query) return escapeHtml(slice);
      return escapeHtml(slice).replace(new RegExp(escapeRegExp(escapeHtml(query)), 'ig'), match => `<mark>${match}</mark>`);
    }

    function renderSearchResults(query) {
      const q = query.trim().toLowerCase();
      if (!q) {
        setPage(currentId, false);
        return;
      }
      const results = docs
        .map(doc => {
          const haystack = `${doc.title}\n${doc.markdown}`.toLowerCase();
          const titleScore = doc.title.toLowerCase().includes(q) ? 10 : 0;
          const bodyScore = haystack.includes(q) ? 1 : 0;
          return { doc, score: titleScore + bodyScore };
        })
        .filter(result => result.score > 0)
        .sort((a, b) => b.score - a.score || a.doc.title.localeCompare(b.doc.title));

      meta.innerHTML = `<span class="pill">${results.length} result${results.length === 1 ? '' : 's'}</span>`;
      toc.innerHTML = '';
      content.innerHTML = `<h1>Search</h1><p class="results-title">Results for ${escapeHtml(query)}</p>${results.map(result => `<section class="result"><button type="button" data-page="${result.doc.id}"><strong>${escapeHtml(result.doc.title)}</strong><span>${excerpt(result.doc.markdown, query)}</span></button></section>`).join('') || '<p class="empty">No matching pages.</p>'}`;
      renderNav(currentId, query);
    }

    nav.addEventListener('click', event => {
      const button = event.target.closest('[data-page]');
      if (!button) return;
      search.value = '';
      setPage(button.dataset.page);
    });

    content.addEventListener('click', event => {
      const pageButton = event.target.closest('[data-page]');
      if (pageButton) {
        search.value = '';
        setPage(pageButton.dataset.page);
        return;
      }

      const copyButton = event.target.closest('.copy-code');
      if (copyButton) {
        const code = copyButton.closest('.codeblock')?.querySelector('code')?.innerText || '';
        navigator.clipboard?.writeText(code);
        copyButton.textContent = 'copied';
        setTimeout(() => { copyButton.textContent = 'copy'; }, 1200);
      }
    });

    toc.addEventListener('click', event => {
      const button = event.target.closest('[data-anchor]');
      if (!button) return;
      document.getElementById(button.dataset.anchor)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    search.addEventListener('input', () => renderSearchResults(search.value));

    menuButton.addEventListener('click', () => sidebar.classList.toggle('open'));

    document.addEventListener('keydown', event => {
      if (event.key === '/' && document.activeElement !== search) {
        event.preventDefault();
        search.focus();
      }
      if (event.key === 'Escape') {
        sidebar.classList.remove('open');
        if (document.activeElement === search) {
          search.value = '';
          setPage(currentId, false);
          search.blur();
        }
      }
    });

    const initialId = decodeURIComponent(location.hash.replace(/^#/, '')) || currentId;
    renderNav(initialId);
    setPage(initialId, false);
  </script>
</body>
</html>
HTML
} >"$DOCS_INDEX"

if (( OPEN_DOCS == 0 )); then
  printf '%s\n' "$DOCS_INDEX"
  exit 0
fi

exec "$HYPRBOLE_PATH/bin/hyprbole-launch-browser" --app="file://$DOCS_INDEX"
