#!/bin/bash

# hyprbole:summary=Refresh VS Code theme from current Hyprbole theme

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib"

current_theme="default-theme"
theme_metadata=""
theme_name=""
theme_extension=""
editor_command=""
apply_theme=1
ui_font=""
mono_font=""
terminal_font=""
ui_font_stack=""
mono_font_stack=""
terminal_font_stack=""

setting_enabled() {
  local key="$1"

  [[ -f $HYPRBOLE_SETTINGS_PATH ]] || return 1
  grep -Eq "^[[:space:]]*${key}[[:space:]]*=[[:space:]]*true([[:space:]]*(#.*)?)?$" "$HYPRBOLE_SETTINGS_PATH"
}

find_editor_command() {
  local command_name="$1"

  command -v "$command_name" >/dev/null 2>&1 || return 1
  printf '%s\n' "$command_name"
}

ensure_editor_theme_extension() {
  local command_name="$1"

  command -v "$command_name" >/dev/null 2>&1 || return 0

  if [[ -n $theme_extension ]] && ! "$command_name" --list-extensions 2>/dev/null | grep -Fxq "$theme_extension"; then
    if ! "$command_name" --install-extension "$theme_extension" --force >/dev/null 2>&1; then
      apply_theme=0
    fi
  fi
}

font_stack() {
  local family="$1"
  local fallback="$2"

  family="${family//\\/\\\\}"
  family="${family//\"/\\\"}"
  printf '"%s", %s\n' "$family" "$fallback"
}

set_editor_settings() {
  local settings_path="$1"
  local force_create="${2:-0}"
  local tmp_file=""

  if [[ $force_create != "1" && ! -e $settings_path ]]; then
    return 0
  fi

  mkdir -p "$(dirname "$settings_path")"

  if [[ -f $settings_path ]]; then
    tmp_file="$(mktemp)"
    if jq \
      --arg theme "$theme_name" \
      --arg apply_theme "$apply_theme" \
      --arg ui_font "$ui_font_stack" \
      --arg mono_font "$mono_font_stack" \
      --arg terminal_font "$terminal_font_stack" \
      'if $apply_theme == "1" then ."workbench.colorTheme" = $theme else . end
      | ."editor.fontFamily" = $mono_font
      | ."debug.console.fontFamily" = $mono_font
      | ."interactiveSession.editor.fontFamily" = $mono_font
      | ."terminal.integrated.fontFamily" = $terminal_font
      | ."markdown.preview.fontFamily" = $ui_font
      | del(."workbench.colorCustomizations"."editor.background")
      | del(."workbench.colorCustomizations"."editor.foreground")
      | del(."workbench.colorCustomizations"."sideBar.background")
      | del(."workbench.colorCustomizations"."activityBar.background")
      | del(."workbench.colorCustomizations"."activityBarBadge.background")
      | del(."workbench.colorCustomizations"."statusBar.background")
      | del(."workbench.colorCustomizations"."tab.inactiveForeground")
      | if ."workbench.colorCustomizations" == {} then del(."workbench.colorCustomizations") else . end' \
      "$settings_path" >"$tmp_file"; then
      mv "$tmp_file" "$settings_path"
    else
      rm -f "$tmp_file"
      printf 'invalid VS Code settings JSON: %s\n' "$settings_path" >&2
      return 1
    fi
  else
    jq -n \
      --arg theme "$theme_name" \
      --arg apply_theme "$apply_theme" \
      --arg ui_font "$ui_font_stack" \
      --arg mono_font "$mono_font_stack" \
      --arg terminal_font "$terminal_font_stack" \
      '(if $apply_theme == "1" then {"workbench.colorTheme": $theme} else {} end) + {
        "editor.fontFamily": $mono_font,
        "debug.console.fontFamily": $mono_font,
        "interactiveSession.editor.fontFamily": $mono_font,
        "terminal.integrated.fontFamily": $terminal_font,
        "markdown.preview.fontFamily": $ui_font
      }' \
      >"$settings_path"
  fi
}

if [[ -f $HYPRBOLE_CONFIG_PATH/current/theme-name ]]; then
  current_theme="$(<"$HYPRBOLE_CONFIG_PATH/current/theme-name")"
fi

theme_metadata="$HYPRBOLE_CONFIG_PATH/current/theme/vscode.json"
[[ -f $theme_metadata ]] || exit 0

theme_name="$(jq -r '.name // empty' "$theme_metadata")"
theme_extension="$(jq -r '.extension // empty' "$theme_metadata")"

[[ -n $theme_name ]] || exit 0

if setting_enabled skip_vscode_theme_changes; then
  apply_theme=0
fi

editor_command="$(find_editor_command code || find_editor_command code-oss || true)"
[[ -n $editor_command ]] || exit 0

if (( apply_theme == 1 )); then
  ensure_editor_theme_extension "$editor_command"
fi

ui_font="$(hyprbole_default_font ui)"
mono_font="$(hyprbole_default_font mono)"
terminal_font="$(hyprbole_default_font terminal)"
ui_font_stack="$(font_stack "$ui_font" "sans-serif")"
mono_font_stack="$(font_stack "$mono_font" "monospace")"
terminal_font_stack="$(font_stack "$terminal_font" "monospace")"

set_editor_settings "$HOME/.config/Code/User/settings.json" 1
set_editor_settings "$HOME/.config/Code - OSS/User/settings.json" 0
