#!/bin/bash

# hyprbole:summary=Refresh Hyprbole tool desktop launchers

set -euo pipefail

HYPRBOLE_PATH="${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}"
APPLICATIONS_DIR="$HOME/.local/share/applications"
DISK_USAGE_DESKTOP_FILE="$APPLICATIONS_DIR/hyprbole-disk-usage.desktop"
DISK_USAGE_LAUNCHER="$HYPRBOLE_PATH/bin/hyprbole launch disk-usage"

write_disk_usage_desktop_file() {
  mkdir -p "$APPLICATIONS_DIR"

  cat >"$DISK_USAGE_DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Disk Usage
GenericName=Disk Usage Analyzer
Comment=Inspect disk usage with dua
Exec=$DISK_USAGE_LAUNCHER
Icon=drive-harddisk
Terminal=false
Categories=System;Utility;
Keywords=disk;usage;storage;space;dua;Hyprbole;
StartupNotify=false
EOF
}

write_disk_usage_desktop_file
