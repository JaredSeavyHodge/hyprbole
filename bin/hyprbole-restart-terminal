#!/bin/bash

# hyprbole:summary=Reload supported terminal emulators after config changes

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib.d/core"

app="$(hyprbole_default_app terminal)"

case "$app" in
  ghostty)
    if pgrep -x ghostty >/dev/null 2>&1; then
      killall -SIGUSR2 ghostty >/dev/null 2>&1 || true
    fi
    ;;
esac
