#!/bin/bash

# hyprbole:summary=Show the cached Hyprbole system health report

set -euo pipefail

STATE_FILE="${HYPRBOLE_HEALTH_STATE_FILE:-/var/lib/hyprbole/health.json}"

if [[ ! -f $STATE_FILE ]]; then
  printf 'Hyprbole health\n\n'
  printf 'No cached health report found.\n'
  printf 'Run: sudo systemctl start hyprbole-health-check.service\n'
  exit 0
fi

command -v jq >/dev/null 2>&1 || {
  printf 'missing required command: jq\n' >&2
  exit 1
}

status="$(jq -r '.status // "unknown"' "$STATE_FILE")"
checked_at="$(jq -r '.checked_at // "unknown"' "$STATE_FILE")"
warning_count="$(jq -r '.warning_count // 0' "$STATE_FILE")"
critical_count="$(jq -r '.critical_count // 0' "$STATE_FILE")"

printf 'Hyprbole health\n\n'
printf 'Status: %s\n' "$status"
printf 'Checked: %s\n' "$checked_at"
printf 'Critical: %s\n' "$critical_count"
printf 'Warnings: %s\n' "$warning_count"

if [[ $status == ok ]]; then
  printf '\nNo issues found.\n'
  exit 0
fi

printf '\nIssues\n'
jq -r '.issues[]? | "\n[\(.severity)] \(.message)\nTarget: \(.target)\nCategory: \(.category)\nDetails: \(.details)"' "$STATE_FILE"

printf '\nTo run a fresh check:\n'
printf 'sudo systemctl start hyprbole-health-check.service\n'
