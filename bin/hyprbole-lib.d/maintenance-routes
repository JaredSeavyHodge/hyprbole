#!/bin/bash

default_app() {
  local role="${1:-}"
  local field="${2:-name}"
  local app

  [[ -n $role ]] || {
    usage
    return 1
  }

  if ! app="$(hyprbole_default_app "$role")"; then
    usage
    return 1
  fi

  case "$field" in
    name)
      printf '%s\n' "$app"
      ;;
    command)
      hyprbole_app_command "$app"
      ;;
    label)
      hyprbole_app_label "$app"
      ;;
    *)
      usage
      return 1
      ;;
  esac
}
refresh_config() {
  hyprbole_load refresh
  hyprbole_refresh_config_path "$1"
}
restart_component() {
  local target="${1:-}"

  case "$target" in
    all)
      hyprbole-restart-all
      ;;
    waybar|bar)
      hyprbole-restart-waybar
      ;;
    wallpaper|wallpapers)
      hyprbole-restart-wallpaper
      ;;
    swaync|notifications)
      systemctl --user restart swaync.service
      ;;
    swayosd|osd)
      hyprbole-restart-swayosd
      ;;
    hypridle|idle)
      hyprbole-restart-hypridle
      ;;
    terminal|term)
      hyprbole-restart-terminal
      ;;
    walker|launcher)
      systemctl --user restart walker.service
      ;;
    elephant)
      systemctl --user restart elephant.service
      ;;
    menus|menu)
      systemctl --user restart elephant.service walker.service
      ;;
    *)
      [[ -n $target ]] && printf 'unknown restart target: %s\n' "$target" >&2
      usage
      return 1
      ;;
  esac
}
verify_system() {
  source "$HYPRBOLE_PATH/install/lib.sh"
  source "$HYPRBOLE_PATH/install/verify.sh"
  verify_installation
}
