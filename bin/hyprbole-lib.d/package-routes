#!/bin/bash

hyprbole_load terminal

ensure_multilib() {
  if pacman -Si steam >/dev/null 2>&1; then
    return 0
  fi

  printf 'Enabling multilib repository...\n'
  sudo_keepalive

  sudo sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//;}' /etc/pacman.conf

  printf 'Syncing package databases...\n'
  sudo pacman -Sy --noconfirm
}
extra_record() {
  local extra_id="$1"
  local record
  local id

  for record in "${HYPRBOLE_CURATED_EXTRA_APPS[@]}"; do
    id="${record%%|*}"
    if [[ $id == "$extra_id" ]]; then
      printf '%s\n' "$record"
      return 0
    fi
  done

  return 1
}
extra_list() {
  local extra_id
  local record
  local id
  local label

  for extra_id in "${HYPRBOLE_INSTALL_EXTRA_APPS[@]}"; do
    record="$(extra_record "$extra_id")" || continue
    IFS='|' read -r id label _ <<<"$record"
    printf '%s\t%s\n' "$id" "$label"
  done
}
extra_install() {
  local extra_id="$1"
  local record
  local id
  local label
  local official_packages_csv
  local aur_packages_csv
  local commands_csv
  local paths_csv
  local official_packages=()
  local aur_packages=()

  [[ -n $extra_id ]] || {
    extra_list
    return 1
  }

  record="$(extra_record "$extra_id")" || {
    printf 'unknown extra: %s\n' "$extra_id" >&2
    printf 'Available extras:\n' >&2
    extra_list >&2
    return 1
  }

  IFS='|' read -r id label official_packages_csv aur_packages_csv commands_csv paths_csv <<<"$record"
  IFS=',' read -ra official_packages <<<"$official_packages_csv"
  IFS=',' read -ra aur_packages <<<"$aur_packages_csv"

  printf 'Installing %s extra...\n' "$label"

  case "$id" in
    steam)
      ensure_multilib
      ;;
  esac

  if [[ -n $official_packages_csv ]]; then
    hyprbole-health-check --disk-space-guard
    sudo_keepalive
    sudo pacman -S --needed --noconfirm "${official_packages[@]}"
  fi

  if [[ -n $aur_packages_csv ]]; then
    command -v yay >/dev/null 2>&1 || {
      printf 'missing required command: yay\n' >&2
      return 1
    }
    hyprbole-health-check --disk-space-guard
    yay -S --needed --noconfirm "${aur_packages[@]}"
  fi

  case "$id" in
    vscode)
      hyprbole-refresh-vscode >/dev/null 2>&1 || true
      ;;
    onepassword)
      systemctl --user restart elephant.service walker.service >/dev/null 2>&1 || true
      ;;
    steam)
      if command -v yay >/dev/null 2>&1; then
        yay -S --needed --noconfirm xpadneo game-devices-udev >/dev/null 2>&1 || \
          printf 'Warning: controller udev/driver packages not available (controllers may need manual setup)\n'
      fi
      ;;
  esac

  printf '%s extra installed.\n' "$label"
}
launch_pkg_installed() {
  hyprbole_launch_floating_terminal com.hyprbole.pkg-installed "Installed Packages" hyprbole pkg installed
}
launch_pkg_install() {
  hyprbole_launch_floating_terminal com.hyprbole.pkg-install "Install Packages" hyprbole pkg install
}
launch_pkg_aur_install() {
  hyprbole_launch_floating_terminal com.hyprbole.pkg-aur-install "Install AUR Packages" hyprbole pkg aur-install
}
launch_extra_install() {
  local extra_id="$1"

  [[ -n $extra_id ]] || {
    extra_list
    return 1
  }

  hyprbole_launch_floating_terminal com.hyprbole.extra-install "Install Extra" bash -lc 'hyprbole extra install "$1"; status=$?; if (( status != 0 )); then printf "\nExtra install failed with status %d\n" "$status"; fi; printf "\nPress Enter to close..."; read -r _; exit "$status"' hyprbole-extra-install "$extra_id"
}
launch_pkg_remove() {
  hyprbole_launch_floating_terminal com.hyprbole.pkg-remove "Remove Packages" bash -lc 'hyprbole pkg remove; status=$?; if (( status != 0 )); then printf "\nPackage removal failed with status %d\n" "$status"; fi; printf "\nPress Enter to close..."; read -r _; exit "$status"'
}
launch_steam() {
  if ! command -v steam >/dev/null 2>&1; then
    launch_extra_install steam
  fi

  exec steam "$@"
}
launch_steam_gaming_mode() {
  if ! command -v steam >/dev/null 2>&1; then
    launch_extra_install steam
  fi

  if ! command -v gamescope >/dev/null 2>&1; then
    launch_extra_install steam
  fi

  exec gamescope -e -f --adaptive-sync -- steam -steamdeck -steamos3 "$@"
}
launch_obsidian() {
  if ! command -v obsidian >/dev/null 2>&1; then
    launch_extra_install obsidian
  fi

  exec uwsm-app -- obsidian "$@"
}
launch_passwords() {
  if ! command -v 1password >/dev/null 2>&1; then
    launch_extra_install onepassword
  fi

  exec uwsm-app -- 1password "$@"
}
pkg_install() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  local fzf_args=(
    --multi
    --preview 'pacman -Sii {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:green,marker:green'
  )

  local pkg_names
  local fzf_status

  pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}") || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }

  if [[ -n $pkg_names ]]; then
    hyprbole-health-check --disk-space-guard
    sudo_keepalive
    printf '%s\n' "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -S --noconfirm
  fi
}
pkg_installed() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    exit 1
  }

  local fzf_args=(
    --preview 'yay -Qi {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:blue'
  )

  local fzf_status

  yay -Qqe | fzf "${fzf_args[@]}" >/dev/null || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }
}
pkg_aur_install() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    exit 1
  }

  local fzf_args=(
    --multi
    --preview 'yay -Siia {1}'
    --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
    --bind 'alt-B:change-preview:yay -Siia {1}'
    --color 'pointer:green,marker:green'
  )

  local pkg_names
  local fzf_status

  pkg_names=$(yay -Slqa | fzf "${fzf_args[@]}") || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }

  if [[ -n $pkg_names ]]; then
    hyprbole-health-check --disk-space-guard
    sudo_keepalive
    printf '%s\n' "$pkg_names" | sed 's/^/aur\//g' | tr '\n' ' ' | xargs yay -S --noconfirm
  fi
}
pkg_remove() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    exit 1
  }

  local fzf_args=(
    --multi
    --preview 'yay -Qi {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:red,marker:red'
  )

  local pkg_names
  local fzf_status

  pkg_names=$(yay -Qqe | fzf "${fzf_args[@]}") || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }

  if [[ -n $pkg_names ]]; then
    sudo_keepalive
    printf '%s\n' "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -Rns --noconfirm
  fi
}
