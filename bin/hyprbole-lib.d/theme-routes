#!/bin/bash

hyprbole_load theme
hyprbole_load terminal

font_config() {
  local command="${1:-}"
  local role="${2:-}"
  local font=""

  case "$command" in
    current)
      if [[ -n $role ]]; then
        hyprbole_default_font "$role"
      else
        printf 'ui=%s\n' "$(hyprbole_default_font ui)"
        printf 'mono=%s\n' "$(hyprbole_default_font mono)"
        printf 'terminal=%s\n' "$(hyprbole_default_font terminal)"
      fi
      ;;
    set)
      [[ -n $role && -n ${3:-} ]] || usage
      shift 2
      font="$*"
      if [[ $role == "all" ]]; then
        hyprbole_set_font ui "$font"
        hyprbole_set_font mono "$font"
        hyprbole_set_font terminal "$font"
      else
        hyprbole_set_font "$role" "$font"
      fi
      hyprbole_apply_font_settings
      hyprbole-refresh-gnome >/dev/null 2>&1 || true
      hyprbole-refresh-vscode >/dev/null 2>&1 || true
      hyprbole-restart-waybar >/dev/null 2>&1 || true
      hyprbole-restart-swayosd >/dev/null 2>&1 || true
      hyprbole-restart-terminal >/dev/null 2>&1 || true
      hyprctl reload >/dev/null 2>&1 || true
      ;;
    *)
      usage
      return 1
    ;;
  esac
}

theme_source_sync_one() {
  local name="$1"
  local repo_url="$2"
  local repo_ref="$3"
  local repo_theme_path="$4"
  local destination="$5"
  local tmp_dir=""
  local config_theme_sources_dir="$HYPRBOLE_CONFIG_PATH/themes/.sources"
  local source_root="$config_theme_sources_dir/$name"

  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || {
    printf 'unsafe theme source name: %s\n' "$name" >&2
    return 1
  }

  case "$destination" in
    "$source_root"/*)
      ;;
    *)
      printf 'unsafe theme source destination for %s: %s\n' "$name" "$destination" >&2
      printf 'theme source destinations must live under: %s/\n' "$source_root" >&2
      return 1
      ;;
  esac

  tmp_dir="$(mktemp -d)"
  trap 'rm -rf "$tmp_dir"' RETURN

  git clone \
    --depth=1 \
    --filter=blob:none \
    --single-branch \
    --branch "$repo_ref" \
    --sparse \
    "$repo_url" \
    "$tmp_dir/source" >/dev/null

  git -C "$tmp_dir/source" sparse-checkout set "$repo_theme_path" >/dev/null

  [[ -d $tmp_dir/source/$repo_theme_path ]] || {
    printf 'theme source %s did not contain path: %s\n' "$name" "$repo_theme_path" >&2
    return 1
  }

  mkdir -p "$(dirname "$destination")"
  rm -rf "$tmp_dir/themes"
  cp -a "$tmp_dir/source/$repo_theme_path" "$tmp_dir/themes"
  rm -rf -- "$destination"
  mv "$tmp_dir/themes" "$destination"

  printf 'synced %s themes to %s\n' "$name" "$destination"
}

theme_source_sync() {
  command -v git >/dev/null 2>&1 || {
    printf 'missing required command: git\n' >&2
    return 1
  }

  while IFS=$'\t' read -r name repo_url repo_ref repo_theme_path local_theme_path; do
    theme_source_sync_one "$name" "$repo_url" "$repo_ref" "$repo_theme_path" "$local_theme_path"
  done < <(hyprbole_theme_source_records)
}

theme_source() {
  local command="${1:-}"

  case "$command" in
    list)
      hyprbole_theme_source_records
      ;;
    add)
      [[ -n ${2:-} && -n ${3:-} && -n ${4:-} && -n ${5:-} ]] || usage
      hyprbole_theme_source_add "$2" "$3" "$4" "$5" "${6:-}"
      ;;
    sync)
      theme_source_sync
      ;;
    edit)
      hyprbole_ensure_theme_sources
      hyprbole_launch_floating_terminal com.hyprbole.theme-sources "Theme Sources" nvim "$HYPRBOLE_THEME_SOURCES_PATH"
      ;;
    *)
      usage
      return 1
      ;;
  esac
}
set_theme() {
  local theme_name="$1"

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  hyprbole_sync_theme_assets "$theme_name"
  hyprbole-refresh-btop >/dev/null 2>&1 || true
  hyprbole-refresh-gnome >/dev/null 2>&1 || true
  hyprbole-restart-wallpaper >/dev/null 2>&1 || true
  (hyprbole-refresh-sddm --noninteractive >/dev/null 2>&1 || true) & disown
  hyprbole-refresh-browser >/dev/null 2>&1 || true
  hyprbole-refresh-vscode >/dev/null 2>&1 || true
  hyprbole-restart-terminal >/dev/null 2>&1 || true
  hyprctl reload >/dev/null 2>&1 || true
  hyprbole-restart-waybar >/dev/null 2>&1 || true
  hyprbole-restart-swayosd >/dev/null 2>&1 || true
}
list_themes() {
  hyprbole_list_themes
}
current_theme() {
  hyprbole_current_theme
}
list_theme_wallpapers() {
  local theme_name="${1:-$(hyprbole_current_theme)}"

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  hyprbole_list_theme_wallpapers "$theme_name"
}
set_theme_wallpaper() {
  local theme_name
  local wallpaper_name

  if [[ -n ${2:-} ]]; then
    theme_name="$1"
    wallpaper_name="$2"
  else
    theme_name="$(hyprbole_current_theme)"
    wallpaper_name="$1"
  fi

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  hyprbole_set_theme_wallpaper "$theme_name" "$wallpaper_name"
  hyprbole-restart-wallpaper >/dev/null 2>&1 || true
  hyprbole-refresh-sddm >/dev/null 2>&1 || true
}
cycle_theme_wallpaper() {
  local theme_name="${1:-$(hyprbole_current_theme)}"
  local current_wallpaper
  local wallpaper_names=()
  local wallpaper_name
  local current_index=-1
  local next_index=0
  local i

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  while IFS= read -r wallpaper_name; do
    [[ -n $wallpaper_name ]] || continue
    wallpaper_names+=("$wallpaper_name")
  done < <(hyprbole_list_theme_wallpapers "$theme_name")

  ((${#wallpaper_names[@]} > 0)) || {
    printf 'no wallpapers available for theme: %s\n' "$theme_name" >&2
    exit 1
  }

  current_wallpaper="$(hyprbole_current_wallpaper)"

  for i in "${!wallpaper_names[@]}"; do
    if [[ ${wallpaper_names[$i]} == "$current_wallpaper" ]]; then
      current_index=$i
      break
    fi
  done

  if (( current_index >= 0 )); then
    next_index=$(((current_index + 1) % ${#wallpaper_names[@]}))
  fi

  set_theme_wallpaper "$theme_name" "${wallpaper_names[$next_index]}"
}
current_theme_wallpaper() {
  hyprbole_current_wallpaper
}
set_custom_wallpaper() {
  local wallpaper_path="$1"

  hyprbole_set_custom_wallpaper "$wallpaper_path"
  hyprbole-restart-wallpaper >/dev/null 2>&1 || true
  hyprbole-refresh-sddm >/dev/null 2>&1 || true
}
cycle_custom_wallpaper() {
  local wallpaper_paths=()
  local wallpaper_path
  local current_wallpaper_path
  local current_index=-1
  local next_index=0
  local i

  while IFS= read -r wallpaper_path; do
    [[ -n $wallpaper_path ]] || continue
    wallpaper_paths+=("$wallpaper_path")
  done < <(hyprbole_list_custom_wallpapers)

  ((${#wallpaper_paths[@]} > 0)) || {
    printf 'no wallpapers available in %s\n' "$HOME/Pictures/Wallpaper" >&2
    exit 1
  }

  current_wallpaper_path="$(hyprbole_current_wallpaper_path || true)"

  for i in "${!wallpaper_paths[@]}"; do
    if [[ ${wallpaper_paths[$i]} == "$current_wallpaper_path" ]]; then
      current_index=$i
      break
    fi
  done

  if (( current_index >= 0 )); then
    next_index=$(((current_index + 1) % ${#wallpaper_paths[@]}))
  fi

  set_custom_wallpaper "${wallpaper_paths[$next_index]}"
}
wallpaper_timer_mode_file() {
  printf '%s\n' "$HYPRBOLE_CONFIG_PATH/current/wallpaper-cycle-mode"
}
wallpaper_timer_interval_file() {
  printf '%s\n' "$HYPRBOLE_CONFIG_PATH/current/wallpaper-cycle-interval"
}
wallpaper_timer_default_interval() {
  printf '10min\n'
}
wallpaper_timer_current_interval() {
  local interval_file

  interval_file="$(wallpaper_timer_interval_file)"
  if [[ -f $interval_file ]]; then
    <"$interval_file" tr -d '\n'
  else
    wallpaper_timer_default_interval
  fi
}
wallpaper_timer_validate_interval() {
  local interval="$1"

  [[ -n $interval ]] || return 1
  systemd-analyze timespan "$interval" >/dev/null 2>&1
}
wallpaper_timer_write_interval_override() {
  local interval="$1"
  local override_dir="$HOME/.config/systemd/user/hyprbole-wallpaper-cycle.timer.d"
  local override_path="$override_dir/override.conf"

  mkdir -p "$override_dir"
  cat >"$override_path" <<EOF
[Timer]
OnBootSec=
OnUnitActiveSec=
OnBootSec=$interval
OnUnitActiveSec=$interval
EOF
}
wallpaper_timer_set_interval() {
  local interval="$1"
  local interval_file

  wallpaper_timer_validate_interval "$interval" || {
    printf 'invalid wallpaper timer interval: %s\n' "$interval" >&2
    exit 1
  }

  interval_file="$(wallpaper_timer_interval_file)"
  mkdir -p "$(dirname "$interval_file")"
  printf '%s\n' "$interval" >"$interval_file"
  wallpaper_timer_write_interval_override "$interval"

  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl --user daemon-reload

  if systemctl --user is-enabled --quiet hyprbole-wallpaper-cycle.timer; then
    systemctl --user restart hyprbole-wallpaper-cycle.timer >/dev/null 2>&1 || true
  fi
}
wallpaper_timer_start() {
  local mode="$1"
  local interval="${2:-}"
  local mode_file

  case "$mode" in
    theme)
      cycle_theme_wallpaper
      ;;
    custom)
      cycle_custom_wallpaper
      ;;
    *)
      printf 'unknown wallpaper timer mode: %s\n' "$mode" >&2
      exit 1
      ;;
  esac

  command -v systemctl >/dev/null 2>&1 || {
    printf 'missing required command: systemctl\n' >&2
    exit 1
  }

  mode_file="$(wallpaper_timer_mode_file)"
  mkdir -p "$(dirname "$mode_file")"
  printf '%s\n' "$mode" >"$mode_file"

  if [[ -n $interval ]]; then
    wallpaper_timer_set_interval "$interval"
  else
    wallpaper_timer_set_interval "$(wallpaper_timer_current_interval)"
  fi

  systemctl --user daemon-reload
  systemctl --user enable --now hyprbole-wallpaper-cycle.timer >/dev/null 2>&1
}
wallpaper_timer_stop() {
  local mode_file

  mode_file="$(wallpaper_timer_mode_file)"
  rm -f "$mode_file"

  command -v systemctl >/dev/null 2>&1 || return 0

  systemctl --user disable --now hyprbole-wallpaper-cycle.timer >/dev/null 2>&1 || true
  systemctl --user stop hyprbole-wallpaper-cycle.service >/dev/null 2>&1 || true
}
wallpaper_timer_status() {
  local mode_file
  local mode="stopped"
  local interval

  interval="$(wallpaper_timer_current_interval)"

  mode_file="$(wallpaper_timer_mode_file)"
  if [[ -f $mode_file ]]; then
    mode="$(<"$mode_file")"
  fi

  if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet hyprbole-wallpaper-cycle.timer; then
    printf 'active mode=%s interval=%s\n' "$mode" "$interval"
  else
    printf 'stopped interval=%s\n' "$interval"
  fi
}
wallpaper_timer_tick() {
  local mode_file
  local mode

  mode_file="$(wallpaper_timer_mode_file)"
  [[ -f $mode_file ]] || exit 0

  mode="$(<"$mode_file")"

  case "$mode" in
    theme)
      cycle_theme_wallpaper
      ;;
    custom)
      cycle_custom_wallpaper
      ;;
    *)
      printf 'unknown wallpaper timer mode: %s\n' "$mode" >&2
      exit 1
      ;;
  esac
}
