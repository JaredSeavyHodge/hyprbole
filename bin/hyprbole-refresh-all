#!/bin/bash

# hyprbole:summary=Refresh Hyprbole runtime state
# hyprbole:args=[--include-user-configs]

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib"

include_user_configs=0

while (( $# > 0 )); do
  case "$1" in
    --include-user-configs)
      include_user_configs=1
      ;;
    *)
      printf 'Usage: hyprbole-refresh-all [--include-user-configs]\n' >&2
      exit 1
      ;;
  esac
  shift
done

hyprbole_sync_theme_assets "$(hyprbole_current_theme)"

for relative_path in "${HYPRBOLE_RETIRED_USER_CONFIG_PATHS[@]}"; do
  rm -f -- "$HOME/.config/$relative_path"
done

if (( include_user_configs == 1 )); then
  for relative_path in "${HYPRBOLE_REFRESH_USER_CONFIG_PATHS[@]}"; do
    hyprbole_refresh_config_path "$relative_path" 1
  done
fi

hyprbole-refresh-btop >/dev/null 2>&1 || true
hyprbole-refresh-browser-launchers >/dev/null 2>&1 || true
hyprbole-refresh-tool-launchers >/dev/null 2>&1 || true
hyprbole-refresh-gnome >/dev/null 2>&1 || true
hyprbole-refresh-fonts >/dev/null 2>&1 || true
hyprbole-refresh-vscode >/dev/null 2>&1 || true
hyprbole-refresh-shell >/dev/null 2>&1 || true
chmod +x "$HYPRBOLE_PATH/bin"/* "$HYPRBOLE_PATH/default/waybar"/*.sh >/dev/null 2>&1 || true
systemctl --user daemon-reload >/dev/null 2>&1 || true
hyprctl reload >/dev/null 2>&1 || true
hyprbole-restart-terminal >/dev/null 2>&1 || true
