#!/bin/bash

# hyprbole:summary=Repair Secret Service keyring defaults
# hyprbole:args=[--quiet] [--user-only]

set -euo pipefail

message=1
user_only=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --quiet)
      message=0
      ;;
    --user-only)
      user_only=1
      ;;
    *)
      printf 'Usage: hyprbole-setup-secret-service [--quiet] [--user-only]\n' >&2
      exit 1
      ;;
  esac
  shift
done

setup_default_keyring() {
  local keyring_dir="$HOME/.local/share/keyrings"
  local default_keyring="$keyring_dir/Default_keyring.keyring"
  local default_file="$keyring_dir/default"
  local login_keyring="$keyring_dir/login.keyring"
  local login_backup

  mkdir -p "$keyring_dir"

  if [[ -e $login_keyring ]]; then
    login_backup="$login_keyring.bak.$(date +%Y%m%d%H%M%S)"
    mv "$login_keyring" "$login_backup"
    if (( message == 1 )); then
      printf 'Backed up encrypted login keyring to %s\n' "$login_backup"
    fi
  fi

  if [[ ! -f $default_keyring ]]; then
    cat >"$default_keyring" <<EOF
[keyring]
display-name=Default keyring
ctime=$(date +%s)
mtime=0
lock-on-idle=false
lock-after=false
EOF
  fi

  printf 'Default_keyring\n' >"$default_file"
  chmod 700 "$keyring_dir"
  chmod 600 "$default_keyring"
  chmod 644 "$default_file"
}

disable_sddm_password_keyring() {
  [[ -f /etc/pam.d/sddm ]] || return 0

  sudo sed -Ei '/^[[:space:]]*-?auth[[:space:]].*pam_gnome_keyring\.so/d' /etc/pam.d/sddm
  sudo sed -Ei '/^[[:space:]]*-?password[[:space:]].*pam_gnome_keyring\.so/d' /etc/pam.d/sddm
}

restart_keyring_daemon() {
  if systemctl --user is-active --quiet gnome-keyring-daemon.service; then
    systemctl --user restart gnome-keyring-daemon.service
    return 0
  fi

  return 1
}

daemon_restarted=0

if (( user_only == 0 )); then
  disable_sddm_password_keyring
fi

setup_default_keyring

if restart_keyring_daemon; then
  daemon_restarted=1
fi

if (( message == 1 )); then
  if (( daemon_restarted == 1 )); then
    printf 'Secret Service default keyring configured. Relaunch apps before retesting them.\n'
  else
    printf 'Secret Service default keyring configured. Log out and back in before retesting apps.\n'
  fi
fi
