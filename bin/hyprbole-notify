#!/bin/bash

# hyprbole:summary=Send a desktop notification
# hyprbole:args=<title> [body]

set -euo pipefail

title=${1:-}
body=${2:-}

[[ -n $title ]] || {
  printf 'Usage: hyprbole-notify <title> [body]\n' >&2
  exit 1
}

if command -v notify-send >/dev/null 2>&1; then
  exec notify-send "$title" "$body"
fi

exit 0
