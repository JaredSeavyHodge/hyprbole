#!/bin/bash

# hyprbole:summary=Print Waybar JSON for cached Hyprbole health state

set -euo pipefail

STATE_FILE="${HYPRBOLE_HEALTH_STATE_FILE:-/var/lib/hyprbole/health.json}"
BELL_ICON=""

emit() {
  local text="$1"
  local class_name="$2"
  local tooltip="$3"

  jq -cn --arg text "$text" --arg class "$class_name" --arg tooltip "$tooltip" '{text: $text, class: $class, tooltip: $tooltip}'
}

if ! command -v jq >/dev/null 2>&1; then
  printf '{"text":"%s","class":"warning","tooltip":"Health indicator missing jq"}\n' "$BELL_ICON"
  exit 0
fi

if [[ ! -f $STATE_FILE ]]; then
  emit "$BELL_ICON" normal "No Alerts"
  exit 0
fi

if ! checked_at="$(jq -r '.checked_at // "unknown"' "$STATE_FILE" 2>/dev/null)"; then
  emit "$BELL_ICON" warning "Health state unreadable"
  exit 0
fi

warning_count="$(jq -r '[.issues[]? | select(.category != "updates" and .severity == "warning")] | length' "$STATE_FILE" 2>/dev/null || printf '0\n')"
critical_count="$(jq -r '[.issues[]? | select(.category != "updates" and .severity == "critical")] | length' "$STATE_FILE" 2>/dev/null || printf '0\n')"
issue_lines="$(jq -r '[.issues[]? | select(.category != "updates")][0:5][] | "\(.severity): \(.message)"' "$STATE_FILE" 2>/dev/null || true)"
[[ $warning_count =~ ^[0-9]+$ ]] || warning_count=0
[[ $critical_count =~ ^[0-9]+$ ]] || critical_count=0

if [[ -z $issue_lines ]]; then
  issue_lines="No issue details available"
fi

if (( critical_count > 0 )); then
  emit "$BELL_ICON" critical "High alert: $critical_count critical, $warning_count warning\nChecked: $checked_at\n$issue_lines"
elif (( warning_count > 0 )); then
  emit "$BELL_ICON" warning "Health warnings: $warning_count\nChecked: $checked_at\n$issue_lines"
else
  emit "$BELL_ICON" normal "No Alerts"
fi
