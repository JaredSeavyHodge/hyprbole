#!/bin/bash

# hyprbole:summary=Refresh GNOME/GTK appearance from current theme

set -euo pipefail

HYPRBOLE_CONFIG_PATH="${HYPRBOLE_CONFIG_PATH:-$HOME/.config/hyprbole}"
CURRENT_THEME_DIR="$HYPRBOLE_CONFIG_PATH/current/theme"

if [[ -f $CURRENT_THEME_DIR/light.mode ]]; then
  gsettings set org.gnome.desktop.interface color-scheme "prefer-light" || true
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita" || true
else
  gsettings set org.gnome.desktop.interface color-scheme "prefer-dark" || true
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark" || true
fi

if [[ -f $CURRENT_THEME_DIR/icons.theme ]]; then
  gsettings set org.gnome.desktop.interface icon-theme "$(<$CURRENT_THEME_DIR/icons.theme)" || true
else
  gsettings set org.gnome.desktop.interface icon-theme "Yaru-blue" || true
fi
