#!/bin/bash

# hyprbole:summary=Hyprbole command entrypoint
# hyprbole:args=<command> [args...]

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib.d/core"

usage() {
  cat <<'EOF'
Hyprbole command center

Usage:
  hyprbole <command> [args...]

Theme:
  themes
  theme list
  theme current
  theme set <name>
  theme source list
  theme source add <name> <repo-url> <ref> <repo-theme-path> [local-theme-path]
  theme source edit
  theme source sync
  theme font current [ui|mono|terminal]
  theme font set <ui|mono|terminal|all> <family>
  theme wallpaper list [theme]
  theme wallpaper current
  theme wallpaper set [theme] <file>
  theme wallpaper cycle [theme]
  wallpaper set <file>
  wallpaper cycle
  wallpaper timer start <theme|custom> [interval]
  wallpaper timer interval <value>
  wallpaper timer stop
  wallpaper timer status

Browser:
  browser setup-theme-policy

Packages:
  pkg installed
  pkg install
  pkg aur-install
  pkg remove
  extra list
  extra install <name>

Tools:
  tools
  utilities
  disk-usage [path...]
  health [refresh|updates]
  mirrors
  mount

Launch:
  apps
  clipboard
  keybinds
  lock
  logout
  menu [menu] [placeholder]
  poweroff
  reboot
  suspend
  launch apps
  launch audio
  launch bluetooth
  launch browser [args...]
  launch btop
  launch menu [menu] [placeholder]
  launch files [args...]
  launch tools
  launch utilities
  launch keybinds
  launch clipboard
  launch launcher
  launch network
  launch disk-usage [path...]
  launch health
  launch mount-share
  launch my-wallpaper-menu
  launch obsidian [args...]
  launch passwords [args...]
  launch steam [args...]
  launch steam-gaming-mode [args...]
  launch themes
  launch wallpaper-menu
  launch update
  launch pkg-installed
  launch pkg-install
  launch pkg-aur-install
  launch pkg-remove
  launch extra-install <name>
  launch terminal [args...]

Capture:
  capture region
  capture screen
  capture record-region
  capture record-screen

System:
  system lock
  system logout
  system info
  power suspend
  power reboot
  power off
  restart <target>

Restart targets:
  all waybar wallpaper swaync swayosd hypridle terminal walker elephant menus

Maintenance:
  docs
  doctor [--verbose] [--fix]
  verify
  update
  refresh-limine
  snapshot <cmd>
  refresh-config <path>
  refresh-all [--include-user-configs]
  refresh-shell
  migrate
  default-app <role> [command|label]
EOF
}

main() {
  case "${1:-}" in
    theme)
      hyprbole_load theme-routes
      case "${2:-}" in
        list)
          list_themes
          ;;
        current)
          current_theme
          ;;
        set)
          [[ -n ${3:-} ]] || usage
          set_theme "$3"
          ;;
        source)
          shift 2
          theme_source "$@"
          ;;
        font)
          shift 2
          font_config "$@"
          ;;
        wallpaper)
          case "${3:-}" in
            current)
              current_theme_wallpaper
              ;;
            list)
              list_theme_wallpapers "${4:-}"
              ;;
            cycle)
              cycle_theme_wallpaper "${4:-}"
              ;;
            set)
              [[ -n ${4:-} ]] || usage
              set_theme_wallpaper "${4:-}" "${5:-}"
              ;;
            *)
              usage
              ;;
          esac
          ;;
        *)
          usage
          ;;
      esac
      ;;
    wallpaper)
      hyprbole_load theme-routes
      case "${2:-}" in
        cycle)
          cycle_custom_wallpaper
          ;;
        set)
          [[ -n ${3:-} ]] || usage
          set_custom_wallpaper "$3"
          ;;
        timer)
          case "${3:-}" in
            start)
              [[ -n ${4:-} ]] || usage
              wallpaper_timer_start "$4" "${5:-}"
              ;;
            interval)
              [[ -n ${4:-} ]] || usage
              wallpaper_timer_set_interval "$4"
              ;;
            status)
              wallpaper_timer_status
              ;;
            stop)
              wallpaper_timer_stop
              ;;
            tick)
              wallpaper_timer_tick
              ;;
            *)
              usage
              ;;
          esac
          ;;
        *)
          usage
          ;;
      esac
      ;;
    themes)
      hyprbole_load launch-routes
      launch_themes
      ;;
    doctor)
      hyprbole_load doctor-routes
      doctor "${@:2}"
      ;;
    verify)
      hyprbole_load maintenance-routes
      verify_system
      ;;
    docs|guide|help)
      hyprbole-docs
      ;;
    browser)
      case "${2:-}" in
        setup-theme-policy)
          hyprbole-setup-browser-policy
          ;;
        *)
          usage
          ;;
      esac
      ;;
    update)
      hyprbole_load update-routes
      update_logged_entry "$0" "$@"
      update_all
      ;;
    mirrors)
      hyprbole_load mirrors
      rate_mirrors
      ;;
    mount)
      hyprbole-mount-share
      ;;
    apps)
      hyprbole_load launch-routes
      launch_apps
      ;;
    tools)
      hyprbole_load launch-routes
      launch_tools
      ;;
    utilities)
      hyprbole_load launch-routes
      launch_tools
      ;;
    disk-usage)
      shift
      hyprbole_load launch-routes
      disk_usage "$@"
      ;;
    health)
      hyprbole_load launch-routes
      health_report "${2:-}"
      ;;
    clipboard)
      hyprbole_load launch-routes
      launch_clipboard
      ;;
    keybinds)
      hyprbole_load launch-routes
      launch_keybinds
      ;;
    lock)
      hyprbole_load system-routes
      system_lock
      ;;
    logout)
      hyprbole_load system-routes
      system_logout
      ;;
    menu)
      hyprbole_load launch-routes
      launch_menu "${2:-hyprbole}" "${3:-Hyprbole menu}"
      ;;
    suspend)
      hyprbole_load system-routes
      power_suspend
      ;;
    reboot)
      hyprbole_load system-routes
      power_reboot
      ;;
    poweroff)
      hyprbole_load system-routes
      power_off
      ;;
    pkg)
      hyprbole_load package-routes
      case "${2:-}" in
        installed)
          pkg_installed
          ;;
        install)
          pkg_install
          ;;
        aur-install)
          pkg_aur_install
          ;;
        remove)
          pkg_remove
          ;;
        *)
          usage
          ;;
      esac
      ;;
    extra|extras)
      hyprbole_load package-routes
      case "${2:-}" in
        list|"")
          extra_list
          ;;
        install)
          [[ -n ${3:-} ]] || usage
          extra_install "$3"
          ;;
        *)
          usage
          ;;
      esac
      ;;
    launch)
      hyprbole_load launch-routes
      case "${2:-}" in
        apps)
          launch_apps
          ;;
        audio)
          launch_audio
          ;;
        bluetooth)
          launch_bluetooth
          ;;
        browser)
          shift 2
          launch_browser "$@"
          ;;
        btop)
          launch_btop
          ;;
        menu)
          launch_menu "${3:-hyprbole}" "${4:-Hyprbole menu}"
          ;;
        files)
          shift 2
          launch_files "$@"
          ;;
        tools)
          launch_tools
          ;;
        utilities)
          launch_tools
          ;;
        keybinds)
          launch_keybinds
          ;;
        clipboard)
          launch_clipboard
          ;;
        launcher)
          launch_launcher
          ;;
        network)
          launch_network
          ;;
        disk-usage)
          shift 2
          launch_disk_usage "$@"
          ;;
        health)
          launch_health
          ;;
        mount-share)
          shift 2
          launch_mount_share
          ;;
        themes)
          launch_themes
          ;;
        my-wallpaper-menu)
          launch_my_wallpaper_menu
          ;;
        obsidian)
          shift 2
          hyprbole_load package-routes
          launch_obsidian "$@"
          ;;
        passwords)
          shift 2
          hyprbole_load package-routes
          launch_passwords "$@"
          ;;
        steam)
          shift 2
          hyprbole_load package-routes
          launch_steam "$@"
          ;;
        steam-gaming-mode)
          shift 2
          hyprbole_load package-routes
          launch_steam_gaming_mode "$@"
          ;;
        wallpaper-menu)
          launch_wallpaper_menu
          ;;
        update)
          launch_update
          ;;
        pkg-installed)
          hyprbole_load package-routes
          launch_pkg_installed
          ;;
        pkg-install)
          hyprbole_load package-routes
          launch_pkg_install
          ;;
        pkg-aur-install)
          hyprbole_load package-routes
          launch_pkg_aur_install
          ;;
        pkg-remove)
          hyprbole_load package-routes
          launch_pkg_remove
          ;;
        extra-install)
          [[ -n ${3:-} ]] || usage
          hyprbole_load package-routes
          launch_extra_install "$3"
          ;;
        terminal)
          shift 2
          launch_terminal "$@"
          ;;
        *)
          usage
          ;;
      esac
      ;;
    capture)
      hyprbole_load capture-routes
      case "${2:-}" in
        region)
          capture_region
          ;;
        screen)
          capture_screen
          ;;
        record-region)
          capture_record_region
          ;;
        record-screen)
          capture_record_screen
          ;;
        *)
          usage
          ;;
      esac
      ;;
    power)
      hyprbole_load system-routes
      case "${2:-}" in
        suspend)
          power_suspend
          ;;
        reboot)
          power_reboot
          ;;
        off|poweroff)
          power_off
          ;;
        *)
          usage
          ;;
      esac
      ;;
    system)
      hyprbole_load system-routes
      case "${2:-}" in
        lock)
          system_lock
          ;;
        logout)
          system_logout
          ;;
        info)
          system_info
          ;;
        *)
          usage
          ;;
      esac
      ;;
    refresh-limine)
      hyprbole-refresh-limine
      ;;
    snapshot)
      [[ -n ${2:-} ]] || usage
      hyprbole-snapshot "$2"
      ;;
    refresh-config)
      [[ -n ${2:-} ]] || usage
      hyprbole_load maintenance-routes
      refresh_config "$2"
      ;;
    refresh-all)
      shift
      hyprbole-refresh-all "$@"
      ;;
    restart)
      hyprbole_load maintenance-routes
      restart_component "${2:-}"
      ;;
    refresh-shell)
      hyprbole-refresh-shell
      ;;
    migrate)
      hyprbole-migrate
      ;;
    default-app)
      hyprbole_load maintenance-routes
      default_app "${2:-}" "${3:-name}"
      ;;
    ""|--help|-h)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
