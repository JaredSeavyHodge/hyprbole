#!/bin/bash

# hyprbole:summary=Hyprbole command entrypoint
# hyprbole:args=<command> [args...]

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib"

UPDATE_ORPHANS_REMOVED=0
UPDATE_CACHE_RECLAIMED_BYTES=0
HYPRBOLE_SUDO_KEEPALIVE_PID=""
if [[ ${1:-} == "update" ]] && [[ -z ${HYPRBOLE_UPDATE_LOGGED:-} ]] && command -v script >/dev/null 2>&1; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env HYPRBOLE_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/hyprbole-update.log"
fi

usage() {
  cat <<'EOF'
Hyprbole command center

Usage:
  hyprbole <command> [args...]

Theme:
  themes
  theme list
  theme current
  theme set <name>
  theme source list
  theme source add <name> <repo-url> <ref> <repo-theme-path> [local-theme-path]
  theme source edit
  theme source sync
  theme font current [ui|mono|terminal]
  theme font set <ui|mono|terminal|all> <family>
  theme wallpaper list [theme]
  theme wallpaper current
  theme wallpaper set [theme] <file>
  theme wallpaper cycle [theme]
  wallpaper set <file>
  wallpaper cycle
  wallpaper timer start <theme|custom> [interval]
  wallpaper timer interval <value>
  wallpaper timer stop
  wallpaper timer status

Browser:
  browser setup-theme-policy

Packages:
  pkg installed
  pkg install
  pkg aur-install
  pkg remove
  extra list
  extra install <name>

Tools:
  tools
  utilities
  disk-usage [path...]
  health [refresh|updates]
  mirrors
  mount

Launch:
  apps
  clipboard
  keybinds
  lock
  logout
  menu [menu] [placeholder]
  poweroff
  reboot
  suspend
  launch apps
  launch menu [menu] [placeholder]
  launch tools
  launch utilities
  launch keybinds
  launch clipboard
  launch launcher
  launch disk-usage [path...]
  launch health
  launch mount-share
  launch my-wallpaper-menu
  launch themes
  launch wallpaper-menu
  launch update
  launch pkg-installed
  launch pkg-install
  launch pkg-aur-install
  launch pkg-remove
  launch extra-install <name>

Capture:
  capture region
  capture screen
  capture record-region
  capture record-screen

System:
  system lock
  system logout
  power suspend
  power reboot
  power off
  restart <target>

Restart targets:
  all waybar wallpaper swaync swayosd hypridle terminal walker elephant menus

Maintenance:
  docs
  doctor [--verbose] [--fix]
  verify
  update
  refresh-limine
  snapshot <cmd>
  refresh-config <path>
  refresh-all [--include-user-configs]
  refresh-shell
  migrate
  default-app <role> [command|label]
EOF
}

default_app() {
  local role="${1:-}"
  local field="${2:-name}"
  local app

  [[ -n $role ]] || {
    usage
    return 1
  }

  if ! app="$(hyprbole_default_app "$role")"; then
    usage
    return 1
  fi

  case "$field" in
    name)
      printf '%s\n' "$app"
      ;;
    command)
      hyprbole_app_command "$app"
      ;;
    label)
      hyprbole_app_label "$app"
      ;;
    *)
      usage
      return 1
      ;;
  esac
}

font_config() {
  local command="${1:-}"
  local role="${2:-}"
  local font=""

  case "$command" in
    current)
      if [[ -n $role ]]; then
        hyprbole_default_font "$role"
      else
        printf 'ui=%s\n' "$(hyprbole_default_font ui)"
        printf 'mono=%s\n' "$(hyprbole_default_font mono)"
        printf 'terminal=%s\n' "$(hyprbole_default_font terminal)"
      fi
      ;;
    set)
      [[ -n $role && -n ${3:-} ]] || usage
      shift 2
      font="$*"
      if [[ $role == "all" ]]; then
        hyprbole_set_font ui "$font"
        hyprbole_set_font mono "$font"
        hyprbole_set_font terminal "$font"
      else
        hyprbole_set_font "$role" "$font"
      fi
      hyprbole_apply_font_settings
      hyprbole-refresh-gnome >/dev/null 2>&1 || true
      hyprbole-refresh-vscode >/dev/null 2>&1 || true
      hyprbole-restart-waybar >/dev/null 2>&1 || true
      hyprbole-restart-swayosd >/dev/null 2>&1 || true
      hyprbole-restart-terminal >/dev/null 2>&1 || true
      hyprctl reload >/dev/null 2>&1 || true
      ;;
    *)
      usage
      return 1
      ;;
  esac
}

theme_source() {
  local command="${1:-}"

  case "$command" in
    list)
      hyprbole_theme_source_records
      ;;
    add)
      [[ -n ${2:-} && -n ${3:-} && -n ${4:-} && -n ${5:-} ]] || usage
      hyprbole_theme_source_add "$2" "$3" "$4" "$5" "${6:-}"
      ;;
    sync)
      "$HYPRBOLE_PATH/bin/hyprbole-sync-theme-sources"
      ;;
    edit)
      hyprbole_ensure_theme_sources
      hyprbole_launch_terminal_command nvim "$HYPRBOLE_THEME_SOURCES_PATH"
      ;;
    *)
      usage
      return 1
      ;;
  esac
}

update_repo() {
  hyprbole_git_checkout "$HYPRBOLE_PATH" || {
    printf 'HYPRBOLE_PATH is not a git checkout root: %s\n' "$HYPRBOLE_PATH" >&2
    printf 'Run install.sh from a git checkout to convert older partial deployments.\n' >&2
    return 1
  }

  if [[ -n $(git -C "$HYPRBOLE_PATH" status --porcelain) ]]; then
    printf 'HYPRBOLE_PATH has uncommitted changes: %s\n' "$HYPRBOLE_PATH" >&2
    printf 'Commit or stash local changes before updating.\n' >&2
    return 11
  fi

  git -C "$HYPRBOLE_PATH" pull --ff-only
}

sudo_keepalive() {
  sudo -v

  while true; do
    sudo -n true || break
    sleep 60
  done 2>/dev/null &

  HYPRBOLE_SUDO_KEEPALIVE_PID=$!
  trap 'if [[ -n ${HYPRBOLE_SUDO_KEEPALIVE_PID:-} ]]; then kill "$HYPRBOLE_SUDO_KEEPALIVE_PID" 2>/dev/null || true; fi' EXIT
}

aur_accessible() {
  command -v curl >/dev/null 2>&1 || return 1

  curl -sf --connect-timeout 30 --retry 3 --retry-delay 3 -A "hyprbole-update" \
    "https://aur.archlinux.org/rpc/?v=5&type=info&arg=base" >/dev/null
}

set_theme() {
  local theme_name="$1"

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  hyprbole_sync_theme_assets "$theme_name"
  hyprbole-refresh-btop >/dev/null 2>&1 || true
  hyprbole-refresh-gnome >/dev/null 2>&1 || true
  hyprbole-restart-wallpaper >/dev/null 2>&1 || true
  (hyprbole-refresh-sddm --noninteractive >/dev/null 2>&1 || true) & disown
  hyprbole-refresh-browser >/dev/null 2>&1 || true
  hyprbole-refresh-vscode >/dev/null 2>&1 || true
  hyprbole-restart-terminal >/dev/null 2>&1 || true
  hyprctl reload >/dev/null 2>&1 || true
  hyprbole-restart-waybar >/dev/null 2>&1 || true
  hyprbole-restart-swayosd >/dev/null 2>&1 || true
}

list_themes() {
  hyprbole_list_themes
}

current_theme() {
  hyprbole_current_theme
}

list_theme_wallpapers() {
  local theme_name="${1:-$(hyprbole_current_theme)}"

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  hyprbole_list_theme_wallpapers "$theme_name"
}

set_theme_wallpaper() {
  local theme_name
  local wallpaper_name

  if [[ -n ${2:-} ]]; then
    theme_name="$1"
    wallpaper_name="$2"
  else
    theme_name="$(hyprbole_current_theme)"
    wallpaper_name="$1"
  fi

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  hyprbole_set_theme_wallpaper "$theme_name" "$wallpaper_name"
  hyprbole-restart-wallpaper >/dev/null 2>&1 || true
  hyprbole-refresh-sddm >/dev/null 2>&1 || true
}

cycle_theme_wallpaper() {
  local theme_name="${1:-$(hyprbole_current_theme)}"
  local current_wallpaper
  local wallpaper_names=()
  local wallpaper_name
  local current_index=-1
  local next_index=0
  local i

  hyprbole_theme_exists "$theme_name" || {
    printf 'unknown theme: %s\n' "$theme_name" >&2
    exit 1
  }

  while IFS= read -r wallpaper_name; do
    [[ -n $wallpaper_name ]] || continue
    wallpaper_names+=("$wallpaper_name")
  done < <(hyprbole_list_theme_wallpapers "$theme_name")

  ((${#wallpaper_names[@]} > 0)) || {
    printf 'no wallpapers available for theme: %s\n' "$theme_name" >&2
    exit 1
  }

  current_wallpaper="$(hyprbole_current_wallpaper)"

  for i in "${!wallpaper_names[@]}"; do
    if [[ ${wallpaper_names[$i]} == "$current_wallpaper" ]]; then
      current_index=$i
      break
    fi
  done

  if (( current_index >= 0 )); then
    next_index=$(((current_index + 1) % ${#wallpaper_names[@]}))
  fi

  set_theme_wallpaper "$theme_name" "${wallpaper_names[$next_index]}"
}

current_theme_wallpaper() {
  hyprbole_current_wallpaper
}

set_custom_wallpaper() {
  local wallpaper_path="$1"

  hyprbole_set_custom_wallpaper "$wallpaper_path"
  hyprbole-restart-wallpaper >/dev/null 2>&1 || true
  hyprbole-refresh-sddm >/dev/null 2>&1 || true
}

cycle_custom_wallpaper() {
  local wallpaper_paths=()
  local wallpaper_path
  local current_wallpaper_path
  local current_index=-1
  local next_index=0
  local i

  while IFS= read -r wallpaper_path; do
    [[ -n $wallpaper_path ]] || continue
    wallpaper_paths+=("$wallpaper_path")
  done < <(hyprbole_list_custom_wallpapers)

  ((${#wallpaper_paths[@]} > 0)) || {
    printf 'no wallpapers available in %s\n' "$HOME/Pictures/Wallpaper" >&2
    exit 1
  }

  current_wallpaper_path="$(hyprbole_current_wallpaper_path || true)"

  for i in "${!wallpaper_paths[@]}"; do
    if [[ ${wallpaper_paths[$i]} == "$current_wallpaper_path" ]]; then
      current_index=$i
      break
    fi
  done

  if (( current_index >= 0 )); then
    next_index=$(((current_index + 1) % ${#wallpaper_paths[@]}))
  fi

  set_custom_wallpaper "${wallpaper_paths[$next_index]}"
}

wallpaper_timer_mode_file() {
  printf '%s\n' "$HYPRBOLE_CONFIG_PATH/current/wallpaper-cycle-mode"
}

wallpaper_timer_interval_file() {
  printf '%s\n' "$HYPRBOLE_CONFIG_PATH/current/wallpaper-cycle-interval"
}

wallpaper_timer_default_interval() {
  printf '10min\n'
}

wallpaper_timer_current_interval() {
  local interval_file

  interval_file="$(wallpaper_timer_interval_file)"
  if [[ -f $interval_file ]]; then
    <"$interval_file" tr -d '\n'
  else
    wallpaper_timer_default_interval
  fi
}

wallpaper_timer_validate_interval() {
  local interval="$1"

  [[ -n $interval ]] || return 1
  systemd-analyze timespan "$interval" >/dev/null 2>&1
}

wallpaper_timer_write_interval_override() {
  local interval="$1"
  local override_dir="$HOME/.config/systemd/user/hyprbole-wallpaper-cycle.timer.d"
  local override_path="$override_dir/override.conf"

  mkdir -p "$override_dir"
  cat >"$override_path" <<EOF
[Timer]
OnBootSec=
OnUnitActiveSec=
OnBootSec=$interval
OnUnitActiveSec=$interval
EOF
}

wallpaper_timer_set_interval() {
  local interval="$1"
  local interval_file

  wallpaper_timer_validate_interval "$interval" || {
    printf 'invalid wallpaper timer interval: %s\n' "$interval" >&2
    exit 1
  }

  interval_file="$(wallpaper_timer_interval_file)"
  mkdir -p "$(dirname "$interval_file")"
  printf '%s\n' "$interval" >"$interval_file"
  wallpaper_timer_write_interval_override "$interval"

  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl --user daemon-reload

  if systemctl --user is-enabled --quiet hyprbole-wallpaper-cycle.timer; then
    systemctl --user restart hyprbole-wallpaper-cycle.timer >/dev/null 2>&1 || true
  fi
}

wallpaper_timer_start() {
  local mode="$1"
  local interval="${2:-}"
  local mode_file

  case "$mode" in
    theme)
      cycle_theme_wallpaper
      ;;
    custom)
      cycle_custom_wallpaper
      ;;
    *)
      printf 'unknown wallpaper timer mode: %s\n' "$mode" >&2
      exit 1
      ;;
  esac

  command -v systemctl >/dev/null 2>&1 || {
    printf 'missing required command: systemctl\n' >&2
    exit 1
  }

  mode_file="$(wallpaper_timer_mode_file)"
  mkdir -p "$(dirname "$mode_file")"
  printf '%s\n' "$mode" >"$mode_file"

  if [[ -n $interval ]]; then
    wallpaper_timer_set_interval "$interval"
  else
    wallpaper_timer_set_interval "$(wallpaper_timer_current_interval)"
  fi

  systemctl --user daemon-reload
  systemctl --user enable --now hyprbole-wallpaper-cycle.timer >/dev/null 2>&1
}

wallpaper_timer_stop() {
  local mode_file

  mode_file="$(wallpaper_timer_mode_file)"
  rm -f "$mode_file"

  command -v systemctl >/dev/null 2>&1 || return 0

  systemctl --user disable --now hyprbole-wallpaper-cycle.timer >/dev/null 2>&1 || true
  systemctl --user stop hyprbole-wallpaper-cycle.service >/dev/null 2>&1 || true
}

wallpaper_timer_status() {
  local mode_file
  local mode="stopped"
  local interval

  interval="$(wallpaper_timer_current_interval)"

  mode_file="$(wallpaper_timer_mode_file)"
  if [[ -f $mode_file ]]; then
    mode="$(<"$mode_file")"
  fi

  if command -v systemctl >/dev/null 2>&1 && systemctl --user is-active --quiet hyprbole-wallpaper-cycle.timer; then
    printf 'active mode=%s interval=%s\n' "$mode" "$interval"
  else
    printf 'stopped interval=%s\n' "$interval"
  fi
}

wallpaper_timer_tick() {
  local mode_file
  local mode

  mode_file="$(wallpaper_timer_mode_file)"
  [[ -f $mode_file ]] || exit 0

  mode="$(<"$mode_file")"

  case "$mode" in
    theme)
      cycle_theme_wallpaper
      ;;
    custom)
      cycle_custom_wallpaper
      ;;
    *)
      printf 'unknown wallpaper timer mode: %s\n' "$mode" >&2
      exit 1
      ;;
  esac
}

doctor_section_start() {
  local section="$1"

  DOCTOR_SECTION="$section"
  DOCTOR_SECTION_OK=0
  DOCTOR_SECTION_WARN=0
  DOCTOR_SECTION_MISS=0

  if (( DOCTOR_VERBOSE == 1 )); then
    if (( DOCTOR_SECTION_COUNT > 0 )); then
      printf '\n'
    fi
    printf '%s\n' "$section"
  fi

  DOCTOR_SECTION_COUNT=$((DOCTOR_SECTION_COUNT + 1))
}

doctor_section_finish() {
  if (( DOCTOR_VERBOSE == 1 )); then
    return 0
  fi

  if (( DOCTOR_SECTION_WARN == 0 && DOCTOR_SECTION_MISS == 0 )); then
    printf 'ok   %s (%d checked)\n' "$DOCTOR_SECTION" "$DOCTOR_SECTION_OK"
  else
    printf 'warn %s (%d ok, %d warn, %d miss)\n' "$DOCTOR_SECTION" "$DOCTOR_SECTION_OK" "$DOCTOR_SECTION_WARN" "$DOCTOR_SECTION_MISS"
  fi
}

doctor_report() {
  local status="$1"
  local message="$2"

  case "$status" in
    ok) DOCTOR_SECTION_OK=$((DOCTOR_SECTION_OK + 1)) ;;
    fix) DOCTOR_SECTION_OK=$((DOCTOR_SECTION_OK + 1)) ;;
    warn) DOCTOR_SECTION_WARN=$((DOCTOR_SECTION_WARN + 1)) ;;
    miss) DOCTOR_SECTION_MISS=$((DOCTOR_SECTION_MISS + 1)) ;;
  esac

  if (( DOCTOR_VERBOSE == 1 )) || [[ $status != "ok" ]]; then
    printf '%-4s %s\n' "$status" "$message"
  fi
}

doctor_fix_secret_service() {
  if "$HYPRBOLE_PATH/bin/hyprbole-setup-secret-service" --quiet >/dev/null 2>&1; then
    doctor_report fix "Secret Service defaults repaired"
  elif "$HYPRBOLE_PATH/bin/hyprbole-setup-secret-service" --quiet --user-only >/dev/null 2>&1; then
    doctor_report fix "Secret Service user defaults repaired; log out and back in if the collection remains locked"
  else
    doctor_report warn "Secret Service repair failed"
  fi
}

doctor_fix_sddm_theme() {
  local source_theme_dir="$HYPRBOLE_PATH/default/sddm/theme"
  local destination_theme_dir="/usr/share/sddm/themes/hyprbole"

  [[ -d $source_theme_dir ]] || return 1

  sudo rm -rf "$destination_theme_dir" || return 1
  sudo install -d "$destination_theme_dir" || return 1
  sudo cp -a "$source_theme_dir/." "$destination_theme_dir/" || return 1

  if [[ -f $HYPRBOLE_PATH/default/sddm/hyprbole.conf ]]; then
    sudo install -Dm644 "$HYPRBOLE_PATH/default/sddm/hyprbole.conf" /etc/sddm.conf.d/hyprbole.conf || return 1
  fi

  "$HYPRBOLE_PATH/bin/hyprbole-refresh-sddm" >/dev/null 2>&1 || true
}

doctor_fix_runtime_process() {
  local fix="$1"

  case "$fix" in
    waybar)
      hyprbole-restart-waybar
      ;;
    wallpaper)
      hyprbole-restart-wallpaper
      ;;
    swaync)
      systemctl --user restart swaync.service
      ;;
    swayosd-server)
      systemctl --user restart swayosd-server.service
      ;;
    walker)
      systemctl --user restart walker.service
      ;;
    elephant)
      systemctl --user restart elephant.service
      ;;
    *)
      return 1
      ;;
  esac
}

doctor_check_runtime_process() {
  local process="$1"
  local label="$2"
  local fix="$3"

  if pgrep -x "$process" >/dev/null 2>&1; then
    doctor_report ok "$label running"
    return 0
  fi

  if (( DOCTOR_FIX == 1 )); then
    if doctor_fix_runtime_process "$fix" >/dev/null 2>&1; then
      sleep 1
      if pgrep -x "$process" >/dev/null 2>&1; then
        doctor_report fix "$label restarted"
      else
        doctor_report warn "$label still not running after restart"
      fi
    else
      doctor_report warn "$label restart failed"
    fi
  else
    doctor_report warn "$label not running"
  fi
}

doctor_check_static_file_current() {
  local source_path="$1"
  local destination_path="$2"
  local label="$3"

  if [[ ! -f $destination_path ]]; then
    doctor_report miss "$label missing"
    return 1
  fi

  if [[ -f $source_path ]] && cmp -s "$source_path" "$destination_path"; then
    doctor_report ok "$label current"
  else
    doctor_report warn "$label differs from Hyprbole default"
    return 1
  fi
}

doctor_check_file_exists() {
  local path="$1"
  local label="$2"

  if [[ -f $path ]]; then
    doctor_report ok "$label"
  else
    doctor_report miss "$label missing"
    return 1
  fi
}

doctor_check_sddm_theme() {
  local config_path="/etc/sddm.conf.d/hyprbole.conf"
  local source_theme_dir="$HYPRBOLE_PATH/default/sddm/theme"
  local theme_dir="/usr/share/sddm/themes/hyprbole"
  local repair_needed=0

  if ! command -v sddm >/dev/null 2>&1; then
    doctor_report miss "sddm command"
    return 0
  fi

  if [[ ! -d $source_theme_dir ]]; then
    doctor_report miss "$source_theme_dir"
    return 0
  fi

  if [[ ! -f $theme_dir/Main.qml ]] || ! cmp -s "$source_theme_dir/Main.qml" "$theme_dir/Main.qml"; then
    repair_needed=1
  fi

  if [[ ! -f $theme_dir/metadata.desktop ]] || ! cmp -s "$source_theme_dir/metadata.desktop" "$theme_dir/metadata.desktop"; then
    repair_needed=1
  fi

  for path in "$theme_dir/theme.conf" "$theme_dir/background.jpg" "$theme_dir/background-blur.jpg"; do
    [[ -f $path ]] || repair_needed=1
  done

  if [[ ! -f $config_path ]] || ! grep -Fxq 'Current=hyprbole' "$config_path"; then
    repair_needed=1
  fi

  if (( DOCTOR_FIX == 1 && repair_needed == 1 )); then
    if doctor_fix_sddm_theme; then
      doctor_report fix "SDDM theme redeployed"
    else
      doctor_report warn "SDDM theme repair failed"
    fi
  fi

  doctor_check_static_file_current "$source_theme_dir/Main.qml" "$theme_dir/Main.qml" "SDDM Main.qml" || true
  doctor_check_static_file_current "$source_theme_dir/metadata.desktop" "$theme_dir/metadata.desktop" "SDDM metadata.desktop" || true
  doctor_check_file_exists "$theme_dir/theme.conf" "SDDM theme.conf" || true
  doctor_check_file_exists "$theme_dir/background.jpg" "SDDM background.jpg" || true
  doctor_check_file_exists "$theme_dir/background-blur.jpg" "SDDM background-blur.jpg" || true

  if [[ -f $config_path ]] && grep -Fxq 'Current=hyprbole' "$config_path"; then
    doctor_report ok "SDDM theme config selects hyprbole"
  else
    doctor_report warn "SDDM theme config does not select hyprbole"
  fi
}

doctor_check_user_unit() {
  local unit="$1"
  local require_active="$2"

  if systemctl --user is-active "$unit" >/dev/null 2>&1; then
    doctor_report ok "$unit active"
    return 0
  fi

  if systemctl --user is-enabled "$unit" >/dev/null 2>&1; then
    if (( require_active == 0 )); then
      doctor_report ok "$unit enabled for graphical session"
      return 0
    fi

    if (( DOCTOR_FIX == 1 )); then
      systemctl --user reset-failed "$unit" >/dev/null 2>&1 || true
      if systemctl --user restart "$unit" >/dev/null 2>&1 && systemctl --user is-active "$unit" >/dev/null 2>&1; then
        doctor_report fix "$unit restarted"
      else
        doctor_report warn "$unit enabled but inactive; restart failed"
      fi
    else
      doctor_report warn "$unit enabled but inactive"
    fi
    return 0
  fi

  if (( DOCTOR_FIX == 1 )); then
    if (( require_active == 1 )); then
      if systemctl --user enable --now "$unit" >/dev/null 2>&1 && systemctl --user is-active "$unit" >/dev/null 2>&1; then
        doctor_report fix "$unit enabled and started"
      else
        doctor_report miss "$unit service"
      fi
    else
      if systemctl --user enable "$unit" >/dev/null 2>&1; then
        doctor_report fix "$unit enabled"
      else
        doctor_report miss "$unit service"
      fi
    fi
  else
    doctor_report miss "$unit service"
  fi
}

doctor_check_default_app_role() {
  local role="$1"
  local app=""
  local command_name=""
  local label=""

  if ! app="$(hyprbole_default_app "$role")"; then
    doctor_report warn "default $role app is not configured"
    return 0
  fi

  command_name="$(hyprbole_app_command "$app")"
  label="$(hyprbole_app_label "$app")"

  if hyprbole_command_available "$command_name"; then
    doctor_report ok "default $role app available: $label ($command_name)"
  else
    doctor_report warn "default $role app command missing: $label ($command_name)"
  fi
}

doctor_check_curated_extra_app() {
  local record="$1"
  local id
  local label
  local official_packages_csv
  local aur_packages_csv
  local commands_csv
  local paths_csv
  local packages=()
  local commands=()
  local paths=()
  local package
  local command_name
  local path
  local present=0

  IFS='|' read -r id label official_packages_csv aur_packages_csv commands_csv paths_csv <<<"$record"

  IFS=',' read -ra packages <<<"$official_packages_csv,$aur_packages_csv"
  for package in "${packages[@]}"; do
    [[ -n $package ]] || continue
    if pacman -Q "$package" >/dev/null 2>&1; then
      present=1
      doctor_report ok "$label package installed: $package"
    fi
  done

  IFS=',' read -ra commands <<<"$commands_csv"
  for command_name in "${commands[@]}"; do
    [[ -n $command_name ]] || continue
    if hyprbole_command_available "$command_name"; then
      present=1
      doctor_report ok "$label command available: $command_name"
    fi
  done

  if (( present == 0 )); then
    doctor_report ok "$label optional extra not installed"
    return 0
  fi

  for command_name in "${commands[@]}"; do
    [[ -n $command_name ]] || continue
    if ! hyprbole_command_available "$command_name"; then
      doctor_report warn "$label command missing: $command_name"
    fi
  done

  IFS=',' read -ra paths <<<"$paths_csv"
  for path in "${paths[@]}"; do
    [[ -n $path ]] || continue
    if [[ -e $path ]]; then
      doctor_report ok "$label integration path: $path"
    else
      doctor_report warn "$label integration path missing: $path"
    fi
  done
}

ensure_multilib() {
  if pacman -Si steam >/dev/null 2>&1; then
    return 0
  fi

  printf 'Enabling multilib repository...\n'
  sudo_keepalive

  sudo sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//;}' /etc/pacman.conf

  printf 'Syncing package databases...\n'
  sudo pacman -Sy --noconfirm
}

extra_record() {
  local extra_id="$1"
  local record
  local id

  for record in "${HYPRBOLE_CURATED_EXTRA_APPS[@]}"; do
    id="${record%%|*}"
    if [[ $id == "$extra_id" ]]; then
      printf '%s\n' "$record"
      return 0
    fi
  done

  return 1
}

extra_list() {
  local extra_id
  local record
  local id
  local label

  for extra_id in "${HYPRBOLE_INSTALL_EXTRA_APPS[@]}"; do
    record="$(extra_record "$extra_id")" || continue
    IFS='|' read -r id label _ <<<"$record"
    printf '%s\t%s\n' "$id" "$label"
  done
}

extra_install() {
  local extra_id="$1"
  local record
  local id
  local label
  local official_packages_csv
  local aur_packages_csv
  local commands_csv
  local paths_csv
  local official_packages=()
  local aur_packages=()

  [[ -n $extra_id ]] || {
    extra_list
    return 1
  }

  record="$(extra_record "$extra_id")" || {
    printf 'unknown extra: %s\n' "$extra_id" >&2
    printf 'Available extras:\n' >&2
    extra_list >&2
    return 1
  }

  IFS='|' read -r id label official_packages_csv aur_packages_csv commands_csv paths_csv <<<"$record"
  IFS=',' read -ra official_packages <<<"$official_packages_csv"
  IFS=',' read -ra aur_packages <<<"$aur_packages_csv"

  printf 'Installing %s extra...\n' "$label"

  case "$id" in
    steam)
      ensure_multilib
      ;;
  esac

  if [[ -n $official_packages_csv ]]; then
    hyprbole-health-check --disk-space-guard
    sudo_keepalive
    sudo pacman -S --needed --noconfirm "${official_packages[@]}"
  fi

  if [[ -n $aur_packages_csv ]]; then
    command -v yay >/dev/null 2>&1 || {
      printf 'missing required command: yay\n' >&2
      return 1
    }
    hyprbole-health-check --disk-space-guard
    yay -S --needed --noconfirm "${aur_packages[@]}"
  fi

  case "$id" in
    vscode)
      hyprbole-refresh-vscode >/dev/null 2>&1 || true
      ;;
    onepassword)
      systemctl --user restart elephant.service walker.service >/dev/null 2>&1 || true
      ;;
    steam)
      if command -v yay >/dev/null 2>&1; then
        yay -S --needed --noconfirm xpadneo game-devices-udev >/dev/null 2>&1 || \
          printf 'Warning: controller udev/driver packages not available (controllers may need manual setup)\n'
      fi
      ;;
  esac

  printf '%s extra installed.\n' "$label"
}

secret_service_read_alias() {
  local alias="$1"
  local output

  if ! output="$(timeout 3 busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service ReadAlias s "$alias" 2>/dev/null)"; then
    return 1
  fi

  case "$output" in
    o\ \"*\")
      output="${output#o \"}"
      output="${output%\"}"
      printf '%s\n' "$output"
      ;;
    *)
      return 1
      ;;
  esac
}

secret_service_collection_state() {
  local path="$1"
  local output

  if ! output="$(timeout 3 busctl --user get-property org.freedesktop.secrets "$path" org.freedesktop.Secret.Collection Locked 2>/dev/null)"; then
    return 1
  fi

  case "$output" in
    b\ true) printf 'locked\n' ;;
    b\ false) printf 'unlocked\n' ;;
    *) return 1 ;;
  esac
}

secret_service_unlock_collection() {
  local path="$1"

  timeout 3 busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service Unlock ao 1 "$path" >/dev/null 2>&1
}

doctor_check_pam_hook() {
  local path="$1"
  local label="$2"
  local type="$3"
  local option="${4:-}"
  local expected="${5:-present}"
  local pattern
  local present=0

  if [[ ! -r $path ]]; then
    doctor_report miss "$label"
    return 0
  fi

  pattern="^[[:space:]]*-?${type}[[:space:]]+.*pam_gnome_keyring\\.so"
  if [[ -n $option ]]; then
    pattern="${pattern}.*${option}"
  fi

  if grep -Eq "$pattern" "$path"; then
    present=1
  fi

  case "$expected" in
    present)
      if (( present == 1 )); then
        doctor_report ok "$label"
      else
        doctor_report warn "$label missing"
        return 1
      fi
      ;;
    absent)
      if (( present == 0 )); then
        doctor_report ok "$label"
      else
        doctor_report warn "$label should be removed"
        return 1
      fi
      ;;
    *)
      doctor_report warn "$label has unknown expectation"
      return 1
      ;;
  esac
}

doctor_check_default_keyring_files() {
  local keyring_dir="$HOME/.local/share/keyrings"
  local default_file="$keyring_dir/default"
  local default_keyring="$keyring_dir/Default_keyring.keyring"
  local login_keyring="$keyring_dir/login.keyring"

  if [[ -f $default_keyring ]]; then
    doctor_report ok "$default_keyring"
  else
    doctor_report warn "$default_keyring missing; run hyprbole doctor --fix"
    return 1
  fi

  if [[ -f $default_file ]] && grep -Fxq 'Default_keyring' "$default_file"; then
    doctor_report ok "$default_file selects Default_keyring"
  else
    doctor_report warn "$default_file does not select Default_keyring"
    return 1
  fi

  if [[ -f $login_keyring ]]; then
    doctor_report warn "$login_keyring remains; it can keep Secret Service on an encrypted login keyring"
    return 1
  else
    doctor_report ok "$login_keyring absent"
  fi
}

doctor_check_secret_service() {
  local alias_path
  local collection_state
  local repair_needed=0
  local secret_service_ready=0

  if command -v secret-tool >/dev/null 2>&1; then
    doctor_report ok "secret-tool command"
  else
    doctor_report miss "secret-tool command"
    repair_needed=1
  fi

  if command -v busctl >/dev/null 2>&1; then
    doctor_report ok "busctl command"
  else
    doctor_report miss "busctl command"
    return 0
  fi

  if timeout 3 busctl --user --no-pager status org.freedesktop.secrets >/dev/null 2>&1; then
    doctor_report ok "org.freedesktop.secrets owned"
    secret_service_ready=1
  else
    doctor_report warn "org.freedesktop.secrets not owned"
    repair_needed=1
  fi

  doctor_check_default_keyring_files || repair_needed=1
  doctor_check_pam_hook /etc/pam.d/sddm "SDDM gnome-keyring auth hook removed" auth "" absent || repair_needed=1
  doctor_check_pam_hook /etc/pam.d/sddm "SDDM gnome-keyring password hook removed" password "" absent || repair_needed=1
  doctor_check_pam_hook /etc/pam.d/sddm "SDDM gnome-keyring session hook" session auto_start || repair_needed=1
  doctor_check_pam_hook /etc/pam.d/sddm-autologin "SDDM autologin gnome-keyring session hook" session auto_start || repair_needed=1

  if (( secret_service_ready == 0 )); then
    if (( DOCTOR_FIX == 1 && repair_needed == 1 )); then
      doctor_fix_secret_service
    fi
    return 0
  fi

  if timeout 3 busctl --user call org.freedesktop.secrets /org/freedesktop/secrets org.freedesktop.Secret.Service OpenSession sv plain s '' >/dev/null 2>&1; then
    doctor_report ok "Secret Service session opens"
  else
    doctor_report warn "Secret Service session open failed"
    repair_needed=1
  fi

  if alias_path="$(secret_service_read_alias default)"; then
    if [[ $alias_path == /org/freedesktop/secrets/collection/* ]]; then
      if [[ $alias_path == */login ]]; then
        doctor_report warn "Secret Service default alias still points to login keyring"
        repair_needed=1
      else
        doctor_report ok "Secret Service default alias -> $alias_path"
      fi

      if collection_state="$(secret_service_collection_state "$alias_path")"; then
        if [[ $collection_state == "unlocked" ]]; then
          doctor_report ok "Secret Service default collection unlocked"
        else
          if (( DOCTOR_FIX == 1 )) && secret_service_unlock_collection "$alias_path" && collection_state="$(secret_service_collection_state "$alias_path")" && [[ $collection_state == "unlocked" ]]; then
            doctor_report fix "Secret Service default collection unlocked"
          else
            doctor_report warn "Secret Service default collection locked"
            repair_needed=1
          fi
        fi
      else
        if (( DOCTOR_FIX == 1 )) && secret_service_unlock_collection "$alias_path" && collection_state="$(secret_service_collection_state "$alias_path")" && [[ $collection_state == "unlocked" ]]; then
          doctor_report fix "Secret Service default collection unlocked"
        else
          doctor_report warn "Secret Service default collection unavailable"
          repair_needed=1
        fi
      fi
    else
      doctor_report warn "Secret Service default alias unset"
      repair_needed=1
    fi
  else
    doctor_report warn "Secret Service default alias unreadable"
    repair_needed=1
  fi

  if (( DOCTOR_FIX == 1 && repair_needed == 1 )); then
    doctor_fix_secret_service
  fi
}

doctor() {
  local binary
  local app
  local failed_units
  local graphical_session_active=0
  local package
  local path
  local policy_path
  local role
  local unit

  local DOCTOR_FIX=0
  local DOCTOR_SECTION=""
  local DOCTOR_SECTION_OK=0
  local DOCTOR_SECTION_WARN=0
  local DOCTOR_SECTION_MISS=0
  local DOCTOR_SECTION_COUNT=0

  DOCTOR_VERBOSE=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --fix) DOCTOR_FIX=1 ;;
      --verbose|-v) DOCTOR_VERBOSE=1 ;;
      *) usage; return 1 ;;
    esac
    shift
  done

  if systemctl --user is-active --quiet graphical-session.target; then
    graphical_session_active=1
  fi

  doctor_section_start "Checkout"
  if [[ -d $HYPRBOLE_PATH/.git ]]; then
    doctor_report ok "$HYPRBOLE_PATH git checkout"
  else
    doctor_report miss "$HYPRBOLE_PATH/.git"
  fi
  doctor_section_finish

  doctor_section_start "Packages: core desktop"
  for package in "${HYPRBOLE_CORE_DESKTOP_PACKAGES[@]}"; do
    if pacman -Q "$package" >/dev/null 2>&1; then
      doctor_report ok "$package"
    else
      doctor_report miss "$package"
    fi
  done
  doctor_section_finish

  doctor_section_start "Competing packages"
  for package in "${HYPRBOLE_CONFLICTING_PACKAGES[@]}"; do
    if pacman -Q "$package" >/dev/null 2>&1; then
      doctor_report warn "$package installed"
    else
      doctor_report ok "$package absent"
    fi
  done
  doctor_section_finish

  doctor_section_start "Packages: apps"
  for package in "${HYPRBOLE_APP_PACKAGES[@]}"; do
    if pacman -Q "$package" >/dev/null 2>&1; then
      doctor_report ok "$package"
    else
      doctor_report miss "$package"
    fi
  done
  doctor_section_finish

  doctor_section_start "Default apps"
  for role in "${HYPRBOLE_RUNTIME_APP_ROLES[@]}"; do
    doctor_check_default_app_role "$role"
  done
  doctor_section_finish

  doctor_section_start "Curated extras"
  for app in "${HYPRBOLE_CURATED_EXTRA_APPS[@]}"; do
    doctor_check_curated_extra_app "$app"
  done
  doctor_section_finish

  doctor_section_start "Packages: launcher"
  for package in "${HYPRBOLE_LAUNCHER_PACKAGES[@]}"; do
    if pacman -Q "$package" >/dev/null 2>&1; then
      doctor_report ok "$package"
    else
      doctor_report miss "$package"
    fi
  done
  doctor_section_finish

  doctor_section_start "Packages: system tools"
  for package in "${HYPRBOLE_SYSTEM_TOOL_PACKAGES[@]}"; do
    if pacman -Q "$package" >/dev/null 2>&1; then
      doctor_report ok "$package"
    else
      doctor_report miss "$package"
    fi
  done
  doctor_section_finish

  doctor_section_start "Commands"
  for binary in "${HYPRBOLE_REQUIRED_COMMANDS[@]}"; do
    if command -v "$binary" >/dev/null 2>&1; then
      doctor_report ok "$binary"
    else
      doctor_report miss "$binary"
    fi
  done
  for binary in "${HYPRBOLE_DOCTOR_HELPER_SCRIPTS[@]}"; do
    if [[ -x $HYPRBOLE_PATH/bin/$binary ]]; then
      doctor_report ok "$binary"
    else
      doctor_report miss "$binary"
    fi
  done
  doctor_section_finish

  doctor_section_start "Services: user"
  for unit in "${HYPRBOLE_CORE_USER_UNITS[@]}"; do
    doctor_check_user_unit "$unit" 1
  done

  for unit in "${HYPRBOLE_GRAPHICAL_USER_UNITS[@]}"; do
    doctor_check_user_unit "$unit" "$graphical_session_active"
  done

  failed_units="$(systemctl --user list-units --state=failed --no-legend --plain 2>/dev/null || true)"
  if [[ -n $failed_units ]]; then
    if (( DOCTOR_FIX == 1 )); then
      systemctl --user reset-failed >/dev/null 2>&1 || true
      failed_units="$(systemctl --user list-units --state=failed --no-legend --plain 2>/dev/null || true)"
      if [[ -n $failed_units ]]; then
        doctor_report warn "failed user services remain"
        printf '%s\n' "$failed_units"
      else
        doctor_report fix "failed user service state reset"
      fi
    else
      doctor_report warn "failed user services present"
      printf '%s\n' "$failed_units"
    fi
  fi
  doctor_section_finish

  doctor_section_start "Runtime"
  if (( graphical_session_active == 1 )); then
    doctor_check_runtime_process waybar "Waybar" waybar
    doctor_check_runtime_process swaync "SwayNC" swaync
    doctor_check_runtime_process swayosd-server "SwayOSD server" swayosd-server
    doctor_check_runtime_process walker "Walker" walker
    doctor_check_runtime_process elephant "Elephant" elephant

    if [[ -f $HYPRBOLE_CONFIG_PATH/current/background ]]; then
      doctor_check_runtime_process awww-daemon "wallpaper daemon" wallpaper
    else
      doctor_report warn "current wallpaper is missing"
    fi
  else
    doctor_report ok "graphical session inactive; runtime checks skipped"
  fi

  if pacman -Si steam >/dev/null 2>&1; then
    doctor_report ok "multilib repository enabled"
  else
    if [[ -f /etc/pacman.conf ]] && grep -q '^#\[multilib\]' /etc/pacman.conf; then
      if (( DOCTOR_FIX == 1 )); then
        sudo sed -i '/^#\[multilib\]$/{s/^#//;n;s/^#//;}' /etc/pacman.conf
        sudo pacman -Sy --noconfirm >/dev/null 2>&1 || true
        doctor_report fix "multilib repository enabled"
      else
        doctor_report warn "multilib repository disabled (run hyprbole doctor --fix to enable)"
      fi
    else
      doctor_report warn "multilib repository not available"
    fi
  fi

  doctor_section_finish

  doctor_section_start "Firewall"
  if command -v ufw >/dev/null 2>&1; then
    if sudo ufw status | grep -q 'Status: active'; then
      doctor_report ok "UFW active"
    else
      doctor_report warn "UFW installed but inactive"
    fi
  else
    doctor_report miss "UFW firewall"
  fi
  doctor_section_finish

  doctor_section_start "Services: system"
  for unit in sddm.service polkit.service; do
    if systemctl is-active "$unit" >/dev/null 2>&1; then
      doctor_report ok "$unit active"
    elif systemctl is-enabled "$unit" >/dev/null 2>&1; then
      doctor_report warn "$unit enabled but inactive"
    else
      doctor_report miss "$unit service"
    fi
  done

  if command -v limine-snapper-sync >/dev/null 2>&1; then
    if systemctl is-enabled limine-snapper-sync.service >/dev/null 2>&1; then
      doctor_report ok "limine-snapper-sync.service enabled"
    else
      doctor_report warn "limine-snapper-sync.service not enabled"
    fi
  fi

  if systemctl is-enabled snapper-cleanup.timer >/dev/null 2>&1; then
    doctor_report ok "snapper-cleanup.timer enabled"
  else
    doctor_report warn "snapper-cleanup.timer not enabled"
  fi

  if systemctl is-enabled hyprbole-health-check.timer >/dev/null 2>&1; then
    doctor_report ok "hyprbole-health-check.timer enabled"
  else
    doctor_report warn "hyprbole-health-check.timer not enabled"
  fi
  doctor_section_finish

  doctor_section_start "SDDM Theme"
  doctor_check_sddm_theme
  doctor_section_finish

  doctor_section_start "Configs"
  for path in "${HYPRBOLE_DOCTOR_CONFIG_PATHS[@]}"; do
    if [[ -e $path ]]; then
      doctor_report ok "$path"
    else
      doctor_report miss "$path"
    fi
  done

  if [[ -f $HOME/.config/hypr/hyprland.conf ]]; then
    doctor_report warn "conflicting Hyprland config: $HOME/.config/hypr/hyprland.conf"
  fi

  if [[ -f $HOME/.config/brave-origin-nightly-flags.conf ]]; then
    if grep -Fxq -- '--password-store=gnome-libsecret' "$HOME/.config/brave-origin-nightly-flags.conf"; then
      doctor_report ok "Brave flags: gnome-libsecret set"
    else
      doctor_report warn "Brave flags: --password-store=gnome-libsecret missing"
    fi
    if grep -Fxq -- '--ozone-platform-hint=auto' "$HOME/.config/brave-origin-nightly-flags.conf"; then
      doctor_report ok "Brave flags: ozone-platform-hint set"
    else
      doctor_report warn "Brave flags: --ozone-platform-hint=auto missing"
    fi
  fi

  if [[ -x $HYPRBOLE_PATH/bin/hyprbole-launch-brave-origin-nightly ]]; then
    doctor_report ok "$HYPRBOLE_PATH/bin/hyprbole-launch-brave-origin-nightly"
  else
    doctor_report miss "$HYPRBOLE_PATH/bin/hyprbole-launch-brave-origin-nightly"
  fi

  if [[ -f /usr/share/applications/brave-origin-nightly.desktop ]]; then
    doctor_report ok "System Brave desktop entry present"
  else
    doctor_report warn "System Brave desktop entry not found (package may be missing)"
  fi

  if [[ -f $HOME/.local/share/applications/hyprbole-disk-usage.desktop ]]; then
    if grep -Fxq "Exec=$HYPRBOLE_PATH/bin/hyprbole-launch-disk-usage" "$HOME/.local/share/applications/hyprbole-disk-usage.desktop"; then
      doctor_report ok "$HOME/.local/share/applications/hyprbole-disk-usage.desktop uses Hyprbole launcher"
    else
      doctor_report warn "$HOME/.local/share/applications/hyprbole-disk-usage.desktop does not use Hyprbole launcher"
    fi
  else
    doctor_report miss "$HOME/.local/share/applications/hyprbole-disk-usage.desktop"
  fi
  doctor_section_finish

  doctor_section_start "Secret Service"
  doctor_check_secret_service
  doctor_section_finish

  doctor_section_start "Theme State"
  for path in "${HYPRBOLE_DOCTOR_THEME_STATE_PATHS[@]}"; do
    if [[ -e $path ]]; then
      doctor_report ok "$path"
    else
      doctor_report miss "$path"
    fi
  done
  doctor_section_finish

  doctor_section_start "Browser Policy"
  policy_path="$HYPRBOLE_CONFIG_PATH/current/browser-policy.json"
  if [[ -f $policy_path ]]; then
    doctor_report ok "$policy_path"
  else
    doctor_report miss "$policy_path"
  fi

  for path in "${HYPRBOLE_BROWSER_POLICY_SYMLINK_PATHS[@]}"; do
    if [[ -L $path ]]; then
      doctor_report ok "$path symlink"
    elif [[ -e $path ]]; then
      doctor_report warn "$path is not a symlink"
    fi
  done
  doctor_section_finish
}

refresh_config() {
  hyprbole_refresh_config_path "$1"
}

restart_component() {
  local target="${1:-}"

  case "$target" in
    all)
      hyprbole-restart-all
      ;;
    waybar|bar)
      hyprbole-restart-waybar
      ;;
    wallpaper|wallpapers)
      hyprbole-restart-wallpaper
      ;;
    swaync|notifications)
      systemctl --user restart swaync.service
      ;;
    swayosd|osd)
      hyprbole-restart-swayosd
      ;;
    hypridle|idle)
      hyprbole-restart-hypridle
      ;;
    terminal|term)
      hyprbole-restart-terminal
      ;;
    walker|launcher)
      systemctl --user restart walker.service
      ;;
    elephant)
      systemctl --user restart elephant.service
      ;;
    menus|menu)
      systemctl --user restart elephant.service walker.service
      ;;
    *)
      [[ -n $target ]] && printf 'unknown restart target: %s\n' "$target" >&2
      usage
      return 1
      ;;
  esac
}

verify_system() {
  source "$HYPRBOLE_PATH/install/lib.sh"
  source "$HYPRBOLE_PATH/install/verify.sh"
  verify_installation
}

launch_menu() {
  local menu_name="${1:-hyprbole}"
  local placeholder="${2:-Hyprbole menu}"

  command -v walker >/dev/null 2>&1 || {
    printf 'missing required command: walker\n' >&2
    exit 1
  }

  command -v elephant >/dev/null 2>&1 || {
    printf 'missing required command: elephant\n' >&2
    exit 1
  }

  exec walker --width 460 --minheight 1 --maxheight 520 --provider "menus:${menu_name}" --placeholder "$placeholder"
}

launch_apps() {
  launch_menu "hyprbole-apps" "Apps"
}

launch_clipboard() {
  command -v walker >/dev/null 2>&1 || {
    printf 'missing required command: walker\n' >&2
    exit 1
  }

  command -v elephant >/dev/null 2>&1 || {
    printf 'missing required command: elephant\n' >&2
    exit 1
  }

  exec walker --width 980 --maxheight 520 --minheight 520 --provider clipboard --placeholder "Clipboard history"
}

launch_keybinds() {
  launch_menu "hyprbole-keybinds" "Keybinds"
}

launch_tools() {
  launch_menu "hyprbole-tools" "Utilities"
}

disk_usage() {
  command -v dua >/dev/null 2>&1 || {
    printf 'missing required command: dua\n' >&2
    exit 1
  }

  exec dua i "$@"
}

launch_disk_usage() {
  hyprbole_launch_floating_terminal com.hyprbole.disk-usage "Disk Usage" bash -lc 'if (($# == 0)); then cd "$HOME" || exit; fi; hyprbole disk-usage "$@"; status=$?; if (( status != 0 )); then printf "\nDisk Usage exited with status %d\n" "$status"; printf "\nPress Enter to close..."; read -r _; fi' hyprbole-disk-usage "$@"
}

health_report() {
  case "${1:-}" in
    "")
      exec hyprbole-health-report
      ;;
    refresh)
      if ! systemctl start hyprbole-health-check.service; then
        printf 'failed to start health check service\n' >&2
        printf 'Try: sudo systemctl start hyprbole-health-check.service\n' >&2
        return 1
      fi
      exec hyprbole-health-report
      ;;
    updates)
      exec hyprbole-health-updates
      ;;
    *)
      usage
      return 1
      ;;
  esac
}

launch_health() {
  hyprbole_launch_floating_terminal com.hyprbole.system "System Health" bash -lc 'hyprbole health; printf "\nPress Enter to close..."; read -r _'
}

