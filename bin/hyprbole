#!/bin/bash

# hyprbole:summary=Hyprbole command entrypoint
# hyprbole:args=<command> [args...]

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib.d/core"

UPDATE_ORPHANS_REMOVED=0
UPDATE_CACHE_RECLAIMED_BYTES=0
HYPRBOLE_SUDO_KEEPALIVE_PID=""
if [[ ${1:-} == "update" ]] && [[ -z ${HYPRBOLE_UPDATE_LOGGED:-} ]] && command -v script >/dev/null 2>&1; then
  script_command=$(printf '%q ' "$0" "$@")
  exec env HYPRBOLE_UPDATE_LOGGED=1 script -qefc "$script_command" "/tmp/hyprbole-update.log"
fi

usage() {
  cat <<'EOF'
Hyprbole command center

Usage:
  hyprbole <command> [args...]

Theme:
  themes
  theme list
  theme current
  theme set <name>
  theme source list
  theme source add <name> <repo-url> <ref> <repo-theme-path> [local-theme-path]
  theme source edit
  theme source sync
  theme font current [ui|mono|terminal]
  theme font set <ui|mono|terminal|all> <family>
  theme wallpaper list [theme]
  theme wallpaper current
  theme wallpaper set [theme] <file>
  theme wallpaper cycle [theme]
  wallpaper set <file>
  wallpaper cycle
  wallpaper timer start <theme|custom> [interval]
  wallpaper timer interval <value>
  wallpaper timer stop
  wallpaper timer status

Browser:
  browser setup-theme-policy

Packages:
  pkg installed
  pkg install
  pkg aur-install
  pkg remove
  extra list
  extra install <name>

Tools:
  tools
  utilities
  disk-usage [path...]
  health [refresh|updates]
  mirrors
  mount

Launch:
  apps
  clipboard
  keybinds
  lock
  logout
  menu [menu] [placeholder]
  poweroff
  reboot
  suspend
  launch apps
  launch audio
  launch bluetooth
  launch browser [args...]
  launch btop
  launch menu [menu] [placeholder]
  launch files [args...]
  launch tools
  launch utilities
  launch keybinds
  launch clipboard
  launch launcher
  launch network
  launch disk-usage [path...]
  launch health
  launch mount-share
  launch my-wallpaper-menu
  launch obsidian [args...]
  launch passwords [args...]
  launch steam [args...]
  launch steam-gaming-mode [args...]
  launch themes
  launch wallpaper-menu
  launch update
  launch pkg-installed
  launch pkg-install
  launch pkg-aur-install
  launch pkg-remove
  launch extra-install <name>
  launch terminal [args...]

Capture:
  capture region
  capture screen
  capture record-region
  capture record-screen

System:
  system lock
  system logout
  power suspend
  power reboot
  power off
  restart <target>

Restart targets:
  all waybar wallpaper swaync swayosd hypridle terminal walker elephant menus

Maintenance:
  docs
  doctor [--verbose] [--fix]
  verify
  update
  refresh-limine
  snapshot <cmd>
  refresh-config <path>
  refresh-all [--include-user-configs]
  refresh-shell
  migrate
  default-app <role> [command|label]
EOF
}

default_app() {
  local role="${1:-}"
  local field="${2:-name}"
  local app

  [[ -n $role ]] || {
    usage
    return 1
  }

  if ! app="$(hyprbole_default_app "$role")"; then
    usage
    return 1
  fi

  case "$field" in
    name)
      printf '%s\n' "$app"
      ;;
    command)
      hyprbole_app_command "$app"
      ;;
    label)
      hyprbole_app_label "$app"
      ;;
    *)
      usage
      return 1
      ;;
  esac
}

refresh_config() {
  hyprbole_refresh_config_path "$1"
}

restart_component() {
  local target="${1:-}"

  case "$target" in
    all)
      hyprbole-restart-all
      ;;
    waybar|bar)
      hyprbole-restart-waybar
      ;;
    wallpaper|wallpapers)
      hyprbole-restart-wallpaper
      ;;
    swaync|notifications)
      systemctl --user restart swaync.service
      ;;
    swayosd|osd)
      hyprbole-restart-swayosd
      ;;
    hypridle|idle)
      hyprbole-restart-hypridle
      ;;
    terminal|term)
      hyprbole-restart-terminal
      ;;
    walker|launcher)
      systemctl --user restart walker.service
      ;;
    elephant)
      systemctl --user restart elephant.service
      ;;
    menus|menu)
      systemctl --user restart elephant.service walker.service
      ;;
    *)
      [[ -n $target ]] && printf 'unknown restart target: %s\n' "$target" >&2
      usage
      return 1
      ;;
  esac
}

verify_system() {
  source "$HYPRBOLE_PATH/install/lib.sh"
  source "$HYPRBOLE_PATH/install/verify.sh"
  verify_installation
}

require_menu_commands() {
  command -v walker >/dev/null 2>&1 || {
    printf 'missing required command: walker\n' >&2
    exit 1
  }

  command -v elephant >/dev/null 2>&1 || {
    printf 'missing required command: elephant\n' >&2
    exit 1
  }
}

launch_menu() {
  local menu_name="${1:-hyprbole}"
  local placeholder="${2:-Hyprbole menu}"

  require_menu_commands

  exec walker --width 460 --minheight 1 --maxheight 520 --provider "menus:${menu_name}" --placeholder "$placeholder"
}

launch_apps() {
  launch_menu "hyprbole-apps" "Apps"
}

launch_clipboard() {
  require_menu_commands

  exec walker --width 980 --maxheight 520 --minheight 520 --provider clipboard --placeholder "Clipboard history"
}

launch_keybinds() {
  launch_menu "hyprbole-keybinds" "Keybinds"
}

launch_tools() {
  launch_menu "hyprbole-tools" "Utilities"
}

launch_default_app_role() {
  local role="$1"
  local app
  local command_name

  shift

  app="$(hyprbole_default_app "$role")" || {
    printf 'unknown default app role: %s\n' "$role" >&2
    return 1
  }
  command_name="$(hyprbole_app_command "$app")"

  command -v "$command_name" >/dev/null 2>&1 || {
    printf 'missing %s command for %s: %s\n' "$role" "$app" "$command_name" >&2
    return 1
  }

  exec "$command_name" "$@"
}

launch_terminal() {
  hyprbole_launch_terminal_command "$@"
}

launch_browser() {
  launch_default_app_role browser "$@"
}

launch_files() {
  launch_default_app_role files "$@"
}

launch_audio() {
  exec pavucontrol
}

launch_network() {
  exec nm-connection-editor
}

launch_bluetooth() {
  command -v blueman-manager >/dev/null 2>&1 || {
    printf 'missing required command: blueman-manager\n' >&2
    return 1
  }

  exec blueman-manager
}

disk_usage() {
  command -v dua >/dev/null 2>&1 || {
    printf 'missing required command: dua\n' >&2
    exit 1
  }

  exec dua i "$@"
}

launch_disk_usage() {
  hyprbole_launch_floating_terminal com.hyprbole.disk-usage "Disk Usage" bash -lc 'if (($# == 0)); then cd "$HOME" || exit; fi; hyprbole disk-usage "$@"; status=$?; if (( status != 0 )); then printf "\nDisk Usage exited with status %d\n" "$status"; printf "\nPress Enter to close..."; read -r _; fi; exit "$status"' hyprbole-disk-usage "$@"
}

health_report() {
  case "${1:-}" in
    "")
      exec hyprbole-health-report
      ;;
    refresh)
      if ! systemctl start hyprbole-health-check.service; then
        printf 'failed to start health check service\n' >&2
        printf 'Try: sudo systemctl start hyprbole-health-check.service\n' >&2
        return 1
      fi
      exec hyprbole-health-report
      ;;
    updates)
      exec hyprbole-health-updates
      ;;
    *)
      usage
      return 1
      ;;
  esac
}

launch_health() {
  hyprbole_launch_floating_terminal com.hyprbole.system "System Health" bash -lc 'hyprbole health; status=$?; printf "\nPress Enter to close..."; read -r _; exit "$status"'
}

launch_launcher() {
  require_menu_commands

  exec walker --width 980 --maxheight 520 --minheight 520
}

launch_themes() {
  require_menu_commands

  exec walker --width 900 --minheight 300 --maxheight 560 --provider menus:hyprbolethemes --placeholder "Select theme"
}

launch_wallpaper_menu() {
  require_menu_commands

  exec walker --width 900 --minheight 300 --maxheight 560 --provider menus:hyprbolewallpapers --placeholder "Select wallpaper"
}

launch_my_wallpaper_menu() {
  require_menu_commands

  exec walker --width 900 --minheight 300 --maxheight 560 --provider menus:hyprbolemywallpapers --placeholder "Select custom wallpaper"
}

launch_update() {
  hyprbole_launch_floating_terminal com.hyprbole.update "Hyprbole Update" bash -lc '
    if hyprbole-update-confirm; then
      hyprbole update
      status=$?
      if (( status == 0 )); then
        printf "\nUpdate complete.\n"
      elif (( status == 11 )); then
        printf "\nUpdate not started.\n"
        printf "Hyprbole has local repo changes that would be overwritten or mixed with an update.\n"
        printf "\nFinish or save your local work first, then run the update again.\n"
        printf "\nUseful commands:\n"
        printf "  git -C \"%s\" status --short\n" "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}"
        printf "  git -C \"%s\" diff\n" "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}"
      else
        printf "\nUpdate failed.\n"
        printf "Review the output above and retry after fixing the issue.\n"
        printf "Log: /tmp/hyprbole-update.log\n"
      fi
    else
      status=0
      printf "\nUpdate cancelled.\n"
    fi

    printf "\nPress Enter to close..."
    read -r _
    exit "$status"
  '
}

capture_region() {
  exec hyprbole-screenshot region
}

capture_screen() {
  exec hyprbole-screenshot screen
}

capture_record_region() {
  exec hyprbole-record-toggle region
}

capture_record_screen() {
  exec hyprbole-record-toggle screen
}

system_lock() {
  if pgrep -x 1password >/dev/null 2>&1; then
    1password --lock >/dev/null 2>&1 || true
  fi

  if ! pgrep -x hyprlock >/dev/null 2>&1; then
    exec hyprlock
  fi
}

system_logout() {
  if command -v uwsm >/dev/null 2>&1; then
    exec uwsm stop
  fi

  local session_id="${XDG_SESSION_ID:-}"

  if [[ -n $session_id ]] && command -v loginctl >/dev/null 2>&1; then
    exec loginctl terminate-session "$session_id"
  fi

  exec pkill -KILL -u "$USER"
}

power_suspend() {
  system_lock || true
  sleep 1
  exec systemctl suspend
}

power_reboot() {
  exec systemctl reboot
}

power_off() {
  exec systemctl poweroff
}

main() {
  case "${1:-}" in
    theme)
      hyprbole_load theme-routes
      case "${2:-}" in
        list)
          list_themes
          ;;
        current)
          current_theme
          ;;
        set)
          [[ -n ${3:-} ]] || usage
          set_theme "$3"
          ;;
        source)
          shift 2
          theme_source "$@"
          ;;
        font)
          shift 2
          font_config "$@"
          ;;
        wallpaper)
          case "${3:-}" in
            current)
              current_theme_wallpaper
              ;;
            list)
              list_theme_wallpapers "${4:-}"
              ;;
            cycle)
              cycle_theme_wallpaper "${4:-}"
              ;;
            set)
              [[ -n ${4:-} ]] || usage
              set_theme_wallpaper "${4:-}" "${5:-}"
              ;;
            *)
              usage
              ;;
          esac
          ;;
        *)
          usage
          ;;
      esac
      ;;
    wallpaper)
      hyprbole_load theme-routes
      case "${2:-}" in
        cycle)
          cycle_custom_wallpaper
          ;;
        set)
          [[ -n ${3:-} ]] || usage
          set_custom_wallpaper "$3"
          ;;
        timer)
          case "${3:-}" in
            start)
              [[ -n ${4:-} ]] || usage
              wallpaper_timer_start "$4" "${5:-}"
              ;;
            interval)
              [[ -n ${4:-} ]] || usage
              wallpaper_timer_set_interval "$4"
              ;;
            status)
              wallpaper_timer_status
              ;;
            stop)
              wallpaper_timer_stop
              ;;
            tick)
              wallpaper_timer_tick
              ;;
            *)
              usage
              ;;
          esac
          ;;
        *)
          usage
          ;;
      esac
      ;;
    themes)
      launch_themes
      ;;
    doctor)
      hyprbole_load doctor-routes
      doctor "${@:2}"
      ;;
    verify)
      verify_system
      ;;
    docs|guide|help)
      hyprbole-docs
      ;;
    browser)
      case "${2:-}" in
        setup-theme-policy)
          hyprbole-setup-browser-policy
          ;;
        *)
          usage
          ;;
      esac
      ;;
    update)
      hyprbole_load update-routes
      update_all
      ;;
    mirrors)
      hyprbole_load mirrors
      rate_mirrors
      ;;
    mount)
      hyprbole-mount-share
      ;;
    apps)
      launch_apps
      ;;
    tools)
      launch_tools
      ;;
    utilities)
      launch_tools
      ;;
    disk-usage)
      shift
      disk_usage "$@"
      ;;
    health)
      health_report "${2:-}"
      ;;
    clipboard)
      launch_clipboard
      ;;
    keybinds)
      launch_keybinds
      ;;
    lock)
      system_lock
      ;;
    logout)
      system_logout
      ;;
    menu)
      launch_menu "${2:-hyprbole}" "${3:-Hyprbole menu}"
      ;;
    suspend)
      power_suspend
      ;;
    reboot)
      power_reboot
      ;;
    poweroff)
      power_off
      ;;
    pkg)
      hyprbole_load package-routes
      case "${2:-}" in
        installed)
          pkg_installed
          ;;
        install)
          pkg_install
          ;;
        aur-install)
          pkg_aur_install
          ;;
        remove)
          pkg_remove
          ;;
        *)
          usage
          ;;
      esac
      ;;
    extra|extras)
      hyprbole_load package-routes
      case "${2:-}" in
        list|"")
          extra_list
          ;;
        install)
          [[ -n ${3:-} ]] || usage
          extra_install "$3"
          ;;
        *)
          usage
          ;;
      esac
      ;;
    launch)
      hyprbole_load terminal
      case "${2:-}" in
        apps)
          launch_apps
          ;;
        audio)
          launch_audio
          ;;
        bluetooth)
          launch_bluetooth
          ;;
        browser)
          shift 2
          launch_browser "$@"
          ;;
        btop)
          hyprbole_launch_floating_terminal com.hyprbole.btop btop btop
          ;;
        menu)
          launch_menu "${3:-hyprbole}" "${4:-Hyprbole menu}"
          ;;
        files)
          shift 2
          launch_files "$@"
          ;;
        tools)
          launch_tools
          ;;
        utilities)
          launch_tools
          ;;
        keybinds)
          launch_keybinds
          ;;
        clipboard)
          launch_clipboard
          ;;
        launcher)
          launch_launcher
          ;;
        network)
          launch_network
          ;;
        disk-usage)
          shift 2
          launch_disk_usage "$@"
          ;;
        health)
          launch_health
          ;;
        mount-share)
          shift 2
          hyprbole_launch_floating_terminal com.hyprbole.mount-share "Mount Share" bash -lc 'hyprbole-mount-share; status=$?; printf "\nPress Enter to close..."; read -r _; exit "$status"'
          ;;
        themes)
          launch_themes
          ;;
        my-wallpaper-menu)
          launch_my_wallpaper_menu
          ;;
        obsidian)
          shift 2
          hyprbole_load package-routes
          launch_obsidian "$@"
          ;;
        passwords)
          shift 2
          hyprbole_load package-routes
          launch_passwords "$@"
          ;;
        steam)
          shift 2
          hyprbole_load package-routes
          launch_steam "$@"
          ;;
        steam-gaming-mode)
          shift 2
          hyprbole_load package-routes
          launch_steam_gaming_mode "$@"
          ;;
        wallpaper-menu)
          launch_wallpaper_menu
          ;;
        update)
          launch_update
          ;;
        pkg-installed)
          hyprbole_load package-routes
          launch_pkg_installed
          ;;
        pkg-install)
          hyprbole_load package-routes
          launch_pkg_install
          ;;
        pkg-aur-install)
          hyprbole_load package-routes
          launch_pkg_aur_install
          ;;
        pkg-remove)
          hyprbole_load package-routes
          launch_pkg_remove
          ;;
        extra-install)
          [[ -n ${3:-} ]] || usage
          hyprbole_load package-routes
          launch_extra_install "$3"
          ;;
        terminal)
          shift 2
          launch_terminal "$@"
          ;;
        *)
          usage
          ;;
      esac
      ;;
    capture)
      case "${2:-}" in
        region)
          capture_region
          ;;
        screen)
          capture_screen
          ;;
        record-region)
          capture_record_region
          ;;
        record-screen)
          capture_record_screen
          ;;
        *)
          usage
          ;;
      esac
      ;;
    power)
      case "${2:-}" in
        suspend)
          power_suspend
          ;;
        reboot)
          power_reboot
          ;;
        off|poweroff)
          power_off
          ;;
        *)
          usage
          ;;
      esac
      ;;
    system)
      case "${2:-}" in
        lock)
          system_lock
          ;;
        logout)
          system_logout
          ;;
        *)
          usage
          ;;
      esac
      ;;
    refresh-limine)
      hyprbole-refresh-limine
      ;;
    snapshot)
      [[ -n ${2:-} ]] || usage
      hyprbole-snapshot "$2"
      ;;
    refresh-config)
      [[ -n ${2:-} ]] || usage
      hyprbole_load refresh
      refresh_config "$2"
      ;;
    refresh-all)
      shift
      hyprbole-refresh-all "$@"
      ;;
    restart)
      restart_component "${2:-}"
      ;;
    refresh-shell)
      hyprbole-refresh-shell
      ;;
    migrate)
      hyprbole-migrate
      ;;
    default-app)
      default_app "${2:-}" "${3:-name}"
      ;;
    ""|--help|-h)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
