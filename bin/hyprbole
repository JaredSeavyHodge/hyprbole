}

launch_extra_install() {
  local extra_id="$1"

  [[ -n $extra_id ]] || {
    extra_list
    return 1
  }

  hyprbole_launch_floating_terminal com.hyprbole.extra-install "Install Extra" bash -lc 'hyprbole extra install "$1"; status=$?; if (( status != 0 )); then printf "\nExtra install failed with status %d\n" "$status"; fi; printf "\nPress Enter to close..."; read -r _' hyprbole-extra-install "$extra_id"
}

launch_pkg_remove() {
  hyprbole_launch_floating_terminal com.hyprbole.pkg-remove "Remove Packages" bash -lc 'hyprbole pkg remove; status=$?; if (( status != 0 )); then printf "\nPackage removal failed with status %d\n" "$status"; fi; printf "\nPress Enter to close..."; read -r _'
}

pkg_install() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  local fzf_args=(
    --multi
    --preview 'pacman -Sii {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:green,marker:green'
  )

  local pkg_names
  local fzf_status

  pkg_names=$(pacman -Slq | fzf "${fzf_args[@]}") || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }

  if [[ -n $pkg_names ]]; then
    hyprbole-health-check --disk-space-guard
    sudo_keepalive
    printf '%s\n' "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -S --noconfirm
  fi
}

pkg_installed() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    exit 1
  }

  local fzf_args=(
    --preview 'yay -Qi {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:blue'
  )

  local fzf_status

  yay -Qqe | fzf "${fzf_args[@]}" >/dev/null || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }
}

pkg_aur_install() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    exit 1
  }

  local fzf_args=(
    --multi
    --preview 'yay -Siia {1}'
    --preview-label='alt-p: toggle description, alt-b/B: toggle PKGBUILD, alt-j/k: scroll, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
    --bind 'alt-B:change-preview:yay -Siia {1}'
    --color 'pointer:green,marker:green'
  )

  local pkg_names
  local fzf_status

  pkg_names=$(yay -Slqa | fzf "${fzf_args[@]}") || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }

  if [[ -n $pkg_names ]]; then
    hyprbole-health-check --disk-space-guard
    sudo_keepalive
    printf '%s\n' "$pkg_names" | sed 's/^/aur\//g' | tr '\n' ' ' | xargs yay -S --noconfirm
  fi
}

pkg_remove() {
  command -v fzf >/dev/null 2>&1 || {
    printf 'missing required command: fzf\n' >&2
    exit 1
  }

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    exit 1
  }

  local fzf_args=(
    --multi
    --preview 'yay -Qi {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'down:65%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:red,marker:red'
  )

  local pkg_names
  local fzf_status

  pkg_names=$(yay -Qqe | fzf "${fzf_args[@]}") || {
    fzf_status=$?
    case "$fzf_status" in
      1|130) return 0 ;;
      *) return "$fzf_status" ;;
    esac
  }

  if [[ -n $pkg_names ]]; then
    sudo_keepalive
    printf '%s\n' "$pkg_names" | tr '\n' ' ' | xargs sudo pacman -Rns --noconfirm
  fi
}

capture_region() {
  exec hyprbole-screenshot region
}

capture_screen() {
  exec hyprbole-screenshot screen
}

capture_record_region() {
  exec hyprbole-record-toggle region
}

capture_record_screen() {
  exec hyprbole-record-toggle screen
}

system_lock() {
  if pgrep -x 1password >/dev/null 2>&1; then
    1password --lock >/dev/null 2>&1 || true
  fi

  if ! pgrep -x hyprlock >/dev/null 2>&1; then
    exec hyprlock
  fi
}

system_logout() {
  if command -v uwsm >/dev/null 2>&1; then
    exec uwsm stop
  fi

  local session_id="${XDG_SESSION_ID:-}"

  if [[ -n $session_id ]] && command -v loginctl >/dev/null 2>&1; then
    exec loginctl terminate-session "$session_id"
  fi

  exec pkill -KILL -u "$USER"
}

power_suspend() {
  system_lock || true
  sleep 1
  exec systemctl suspend
}

power_reboot() {
  exec systemctl reboot
}

power_off() {
  exec systemctl poweroff
}

current_pacman_log_lines() {
  if [[ -f /var/log/pacman.log ]]; then
    wc -l < /var/log/pacman.log
  else
    printf '0\n'
  fi
}

package_cache_size_bytes() {
  local size=0

  if [[ -d /var/cache/pacman/pkg ]]; then
    read -r size _ < <(du -sb /var/cache/pacman/pkg 2>/dev/null || printf '0 -\n')
  fi

  printf '%s\n' "$size"
}

format_bytes() {
  if command -v numfmt >/dev/null 2>&1; then
    numfmt --to=iec-i --suffix=B "$1"
  else
    printf '%s bytes\n' "$1"
  fi
}

cleanup_orphan_packages() {
  local orphans

  orphans=$(pacman -Qtdq || true)
  if [[ -n $orphans ]]; then
    printf '\nRemove orphan system packages\n'
    for pkg in $orphans; do
      if sudo pacman -Rs --noconfirm "$pkg"; then
        ((UPDATE_ORPHANS_REMOVED += 1))
      fi
    done
  fi
}

cleanup_package_cache() {
  local cache_size_before
  local cache_size_after

  if command -v paccache >/dev/null 2>&1; then
    printf '\nTrim package cache\n'
    cache_size_before=$(package_cache_size_bytes)
    sudo paccache -rk2 || true
    cache_size_after=$(package_cache_size_bytes)

    if (( cache_size_after < cache_size_before )); then
      UPDATE_CACHE_RECLAIMED_BYTES=$((cache_size_before - cache_size_after))
    fi
  fi
}

print_update_summary() {
  local pacman_log_start_line="$1"
  local upgraded=0
  local installed=0
  local removed=0

  if [[ -f /var/log/pacman.log ]]; then
    upgraded=$(sed -n "$((pacman_log_start_line + 1)),\$p" /var/log/pacman.log | grep -c '\[ALPM\] upgraded ' || true)
    installed=$(sed -n "$((pacman_log_start_line + 1)),\$p" /var/log/pacman.log | grep -c '\[ALPM\] installed ' || true)
    removed=$(sed -n "$((pacman_log_start_line + 1)),\$p" /var/log/pacman.log | grep -c '\[ALPM\] removed ' || true)
  fi

  printf '\nUpdate summary\n'
  printf 'Upgraded packages: %s\n' "$upgraded"
  printf 'Installed packages: %s\n' "$installed"
  printf 'Removed packages: %s\n' "$removed"
  printf 'Orphan packages removed: %s\n' "$UPDATE_ORPHANS_REMOVED"
  printf 'Package cache reclaimed: %s\n' "$(format_bytes "$UPDATE_CACHE_RECLAIMED_BYTES")"
  printf 'Update log: /tmp/hyprbole-update.log\n'
}

update_system_time() {
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl list-unit-files systemd-timesyncd.service >/dev/null 2>&1 || return 0

  printf 'Updating time...\n'
  sudo systemctl restart systemd-timesyncd.service || true
}

update_arch_keyring() {
  printf '\nUpdate Arch signing keys\n'
  # This sync is immediately followed by a full system upgrade.
  sudo pacman -Sy --noconfirm archlinux-keyring >/dev/null 2> >(grep -vE '^warning: archlinux-keyring-[^ ]+ is up to date -- reinstalling$' >&2)
  printf 'Keys are correct\n'
}

update_aur_packages() {
  pacman -Qem >/dev/null 2>&1 || return 0

  command -v yay >/dev/null 2>&1 || {
    printf 'missing required command: yay\n' >&2
    return 1
  }

  if aur_accessible; then
    printf '\nUpdate AUR packages\n'
    yay -Sua --cleanafter --noconfirm --answerclean None --answerdiff None --answeredit None --answerupgrade None
    printf '\n'
  else
    printf '\nAUR is unavailable; skipping AUR package updates\n\n' >&2
  fi
}

analyze_update_log() {
  local update_log=/tmp/hyprbole-update.log

  [[ -f $update_log ]] || return 0

  if grep -q 'Updating linux initcpios' "$update_log" && ! grep -q 'Initcpio image generation successful' "$update_log"; then
    printf '\nError: initramfs generation may have failed. Review logs before restart.\n\n' >&2
  fi
}

update_all() {
  local pacman_log_start_line

  trap 'status=$?; if (( status != 11 )); then printf "\nUpdate failed. Review the output above and retry after fixing the issue.\nLog: /tmp/hyprbole-update.log\n" >&2; fi; return "$status"' ERR

  UPDATE_ORPHANS_REMOVED=0
  UPDATE_CACHE_RECLAIMED_BYTES=0
  pacman_log_start_line=$(current_pacman_log_lines)

  # Prevent idle/suspend from interrupting long-running updates.
  hyprctl dispatch tagwindow +noidle >/dev/null 2>&1 || true

  trap 'hyprctl dispatch tagwindow -- -noidle >/dev/null 2>&1 || true' RETURN

  update_repo
  sudo_keepalive
  update_system_time

  if command -v pacman >/dev/null 2>&1; then
    update_arch_keyring
  fi

  hyprbole-snapshot create || [[ $? -eq 127 ]]
  hyprbole-health-check --disk-space-guard
  sudo pacman -Syyu --noconfirm
  hyprbole-migrate
  update_aur_packages
  cleanup_orphan_packages
  cleanup_package_cache
  hyprbole-refresh-all
  hyprbole-refresh-limine >/dev/null 2>&1 || true
  analyze_update_log
  print_update_summary "$pacman_log_start_line"
  sudo systemctl start hyprbole-health-check.service >/dev/null 2>&1 || true
}

main() {
  case "${1:-}" in
    theme)
      case "${2:-}" in
        list)
          list_themes
          ;;
        current)
          current_theme
          ;;
        set)
          [[ -n ${3:-} ]] || usage
          set_theme "$3"
          ;;
        source)
          shift 2
          theme_source "$@"
          ;;
        font)
          shift 2
          font_config "$@"
          ;;
        wallpaper)
          case "${3:-}" in
            current)
              current_theme_wallpaper
              ;;
            list)
              list_theme_wallpapers "${4:-}"
              ;;
            cycle)
              cycle_theme_wallpaper "${4:-}"
              ;;
            set)
              [[ -n ${4:-} ]] || usage
              set_theme_wallpaper "${4:-}" "${5:-}"
              ;;
            *)
              usage
              ;;
          esac
          ;;
        *)
          usage
          ;;
      esac
      ;;
    wallpaper)
      case "${2:-}" in
        cycle)
          cycle_custom_wallpaper
          ;;
        set)
          [[ -n ${3:-} ]] || usage
          set_custom_wallpaper "$3"
          ;;
        timer)
          case "${3:-}" in
            start)
              [[ -n ${4:-} ]] || usage
              wallpaper_timer_start "$4" "${5:-}"
              ;;
            interval)
              [[ -n ${4:-} ]] || usage
              wallpaper_timer_set_interval "$4"
              ;;
            status)
              wallpaper_timer_status
              ;;
            stop)
              wallpaper_timer_stop
              ;;
            tick)
              wallpaper_timer_tick
              ;;
            *)
              usage
              ;;
          esac
          ;;
        *)
          usage
          ;;
      esac
      ;;
    themes)
      launch_themes
      ;;
    doctor)
      doctor "${@:2}"
      ;;
    verify)
      verify_system
      ;;
    docs|guide|help)
      hyprbole-docs
      ;;
    browser)
      case "${2:-}" in
        setup-theme-policy)
          hyprbole-setup-browser-policy
          ;;
        *)
          usage
          ;;
      esac
      ;;
    update)
      update_all
      ;;
    mirrors)
      rate_mirrors
      ;;
    mount)
      hyprbole-mount-share
      ;;
    apps)
      launch_apps
      ;;
    tools)
      launch_tools
      ;;
    utilities)
      launch_tools
      ;;
    disk-usage)
      shift
      disk_usage "$@"
      ;;
    health)
      health_report "${2:-}"
      ;;
    clipboard)
      launch_clipboard
      ;;
    keybinds)
      launch_keybinds
      ;;
    lock)
      system_lock
      ;;
    logout)
      system_logout
      ;;
    menu)
      launch_menu "${2:-hyprbole}" "${3:-Hyprbole menu}"
      ;;
    suspend)
      power_suspend
      ;;
    reboot)
      power_reboot
      ;;
    poweroff)
      power_off
      ;;
    pkg)
      case "${2:-}" in
        installed)
          pkg_installed
          ;;
        install)
          pkg_install
          ;;
        aur-install)
          pkg_aur_install
          ;;
        remove)
          pkg_remove
          ;;
        *)
          usage
          ;;
      esac
      ;;
    extra|extras)
      case "${2:-}" in
        list|"")
          extra_list
          ;;
        install)
          [[ -n ${3:-} ]] || usage
          extra_install "$3"
          ;;
        *)
          usage
          ;;
      esac
      ;;
    launch)
      case "${2:-}" in
        apps)
          launch_apps
          ;;
        menu)
          launch_menu "${3:-hyprbole}" "${4:-Hyprbole menu}"
          ;;
        tools)
          launch_tools
          ;;
        utilities)
          launch_tools
          ;;
        keybinds)
          launch_keybinds
          ;;
        clipboard)
          launch_clipboard
          ;;
        launcher)
          launch_launcher
          ;;
        disk-usage)
          shift 2
          launch_disk_usage "$@"
          ;;
        health)
          launch_health
          ;;
        mount-share)
          shift 2
          hyprbole_launch_floating_terminal com.hyprbole.mount-share "Mount Share" bash -lc 'hyprbole-mount-share; printf "\nPress Enter to close..."; read -r _'
          ;;
        themes)
          launch_themes
          ;;
        my-wallpaper-menu)
          launch_my_wallpaper_menu
          ;;
        wallpaper-menu)
          launch_wallpaper_menu
          ;;
        update)
          launch_update
          ;;
        pkg-installed)
          launch_pkg_installed
          ;;
        pkg-install)
          launch_pkg_install
          ;;
        pkg-aur-install)
          launch_pkg_aur_install
          ;;
        pkg-remove)
          launch_pkg_remove
          ;;
        extra-install)
          [[ -n ${3:-} ]] || usage
          launch_extra_install "$3"
          ;;
        *)
          usage
          ;;
      esac
      ;;
    capture)
      case "${2:-}" in
        region)
          capture_region
          ;;
        screen)
          capture_screen
          ;;
        record-region)
          capture_record_region
          ;;
        record-screen)
          capture_record_screen
          ;;
        *)
          usage
          ;;
      esac
      ;;
    power)
      case "${2:-}" in
        suspend)
          power_suspend
          ;;
        reboot)
          power_reboot
          ;;
        off|poweroff)
          power_off
          ;;
        *)
          usage
          ;;
      esac
      ;;
    system)
      case "${2:-}" in
        lock)
          system_lock
          ;;
        logout)
          system_logout
          ;;
        *)
          usage
          ;;
      esac
      ;;
    refresh-limine)
      hyprbole-refresh-limine
      ;;
    snapshot)
      [[ -n ${2:-} ]] || usage
      hyprbole-snapshot "$2"
      ;;
    refresh-config)
      [[ -n ${2:-} ]] || usage
      refresh_config "$2"
      ;;
    refresh-all)
      shift
      hyprbole-refresh-all "$@"
      ;;
    restart)
      restart_component "${2:-}"
      ;;
    refresh-shell)
      hyprbole-refresh-shell
      ;;
    migrate)
      hyprbole-migrate
      ;;
    default-app)
      default_app "${2:-}" "${3:-name}"
      ;;
    ""|--help|-h)
      usage
      ;;
    *)
      usage
      exit 1
      ;;
  esac
}

main "$@"
