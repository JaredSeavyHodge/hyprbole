#!/bin/bash

# hyprbole:summary=Show system summary in terminal

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib.d/core"
hyprbole_load terminal

if command -v fastfetch >/dev/null 2>&1; then
  hyprbole_launch_floating_terminal com.hyprbole.system system bash -lc 'fastfetch; exec bash'
fi

if command -v neofetch >/dev/null 2>&1; then
  hyprbole_launch_floating_terminal com.hyprbole.system system bash -lc 'neofetch; exec bash'
fi

hyprbole_launch_floating_terminal com.hyprbole.system system bash -lc 'printf "fastfetch/neofetch not installed\n"; exec bash'
