#!/bin/bash

# hyprbole:summary=Run lightweight Hyprbole system health checks

set -euo pipefail

STATE_DIR="${HYPRBOLE_HEALTH_STATE_DIR:-/var/lib/hyprbole}"
STATE_FILE="${HYPRBOLE_HEALTH_STATE_FILE:-$STATE_DIR/health.json}"
DISK_WARNING_THRESHOLD="${HYPRBOLE_DISK_WARNING_THRESHOLD:-95}"
DISK_BLOCK_THRESHOLD="${HYPRBOLE_DISK_BLOCK_THRESHOLD:-98}"
NVME_WEAR_WARNING="${HYPRBOLE_NVME_WEAR_WARNING:-80}"
NVME_WEAR_CRITICAL="${HYPRBOLE_NVME_WEAR_CRITICAL:-100}"
NVME_TEMP_WARNING="${HYPRBOLE_NVME_TEMP_WARNING:-70}"
NVME_TEMP_CRITICAL="${HYPRBOLE_NVME_TEMP_CRITICAL:-80}"

issues_file=""
warning_count=0
critical_count=0

cleanup() {
  [[ -n $issues_file && -f $issues_file ]] && rm -f "$issues_file"
  return 0
}
trap cleanup EXIT

is_int() {
  [[ ${1:-} =~ ^[0-9]+$ ]]
}

to_int() {
  local value="${1:-}"

  value="${value%%%}"
  case "$value" in
    ""|null) return 1 ;;
  esac

  if [[ $value =~ ^0[xX][0-9A-Fa-f]+$ ]]; then
    printf '%d\n' "$((value))"
  elif [[ $value =~ ^[0-9]+$ ]]; then
    printf '%d\n' "$((10#$value))"
  else
    return 1
  fi
}

local_filesystem_type() {
  case "$1" in
    btrfs|ext2|ext3|ext4|xfs|f2fs|bcachefs|vfat|exfat) return 0 ;;
    *) return 1 ;;
  esac
}

disk_usage_rows() {
  local target
  local source
  local fstype
  local key
  local percent
  declare -A seen=()
  declare -A targets=()
  declare -A sources=()
  declare -A fstypes=()
  declare -A mounts=()

  while read -r target source fstype _; do
    [[ -n ${target:-} && -n ${source:-} && -n ${fstype:-} ]] || continue
    local_filesystem_type "$fstype" || continue

    key="$source"
    if [[ $fstype == btrfs ]]; then
      key="${source%%\[*}"
    fi

    if [[ -n ${seen[$key]+x} ]]; then
      mounts[$key]="${mounts[$key]}, $target"
      continue
    fi

    seen[$key]=1
    targets[$key]="$target"
    sources[$key]="$source"
    fstypes[$key]="$fstype"
    mounts[$key]="$target"
  done < <(findmnt --real -rn -o TARGET,SOURCE,FSTYPE 2>/dev/null || true)

  for key in "${!targets[@]}"; do
    target="${targets[$key]}"
    percent="$(df -P "$target" 2>/dev/null | awk 'NR == 2 { gsub("%", "", $5); print $5 }' || true)"
    is_int "$percent" || continue

    printf '%s\t%s\t%s\t%s\t%s\n' "$percent" "$target" "${sources[$key]}" "${fstypes[$key]}" "${mounts[$key]}"
  done
}

disk_space_guard() {
  local threshold="${1:-$DISK_BLOCK_THRESHOLD}"
  local blocked=0
  local percent
  local target
  local source
  local fstype
  local mounts

  is_int "$threshold" || {
    printf 'invalid disk space threshold: %s\n' "$threshold" >&2
    return 2
  }

  while IFS=$'\t' read -r percent target source fstype mounts; do
    if (( percent >= threshold )); then
      printf 'filesystem is %s%% full: %s (%s, %s)\n' "$percent" "$target" "$source" "$fstype" >&2
      if [[ $mounts != "$target" ]]; then
        printf 'related mounts: %s\n' "$mounts" >&2
      fi
      blocked=1
    fi
  done < <(disk_usage_rows)

  if (( blocked == 1 )); then
    printf 'refusing package operation because a local filesystem is at or above %s%% usage\n' "$threshold" >&2
    printf 'free disk space first, then retry\n' >&2
    return 1
  fi

  return 0
}

add_issue() {
  local severity="$1"
  local category="$2"
  local target="$3"
  local message="$4"
  local details="${5:-}"

  case "$severity" in
    critical) critical_count=$((critical_count + 1)) ;;
    warning) warning_count=$((warning_count + 1)) ;;
  esac

  jq -cn \
    --arg severity "$severity" \
    --arg category "$category" \
    --arg target "$target" \
    --arg message "$message" \
    --arg details "$details" \
    '{severity: $severity, category: $category, target: $target, message: $message, details: $details}' >>"$issues_file"
}

json_int() {
  local json="$1"
  local filter="$2"
  local value

  value="$(jq -r "$filter // empty" <<<"$json" 2>/dev/null | head -n 1 | tr -d '%' || true)"
  to_int "$value"
}

scan_disk_usage() {
  local percent
  local target
  local source
  local fstype
  local mounts

  while IFS=$'\t' read -r percent target source fstype mounts; do
    if (( percent >= DISK_WARNING_THRESHOLD )); then
      add_issue warning disk-usage "$target" \
        "Filesystem is ${percent}% full" \
        "source=$source; type=$fstype; mounts=$mounts"
    fi
  done < <(disk_usage_rows)
}

scan_root_read_only() {
  local options

  options="$(findmnt -rn -o OPTIONS / 2>/dev/null || true)"
  if [[ ,$options, == *,ro,* ]]; then
    add_issue critical filesystem / "Root filesystem is mounted read-only" "options=$options"
  fi
}

scan_nvme_health() {
  local device
  local devices=()
  local json
  local critical_warning
  local available_spare
  local spare_threshold
  local percent_used
  local media_errors
  local temperature
  local temperature_c

  shopt -s nullglob
  for device in /dev/nvme[0-9]*; do
    [[ $device == *n[0-9]* ]] && continue
    devices+=("$device")
  done
  shopt -u nullglob

  ((${#devices[@]} > 0)) || return 0

  if ! command -v nvme >/dev/null 2>&1; then
    add_issue warning nvme nvme "nvme-cli is missing; NVMe health checks skipped" "install package: nvme-cli"
    return 0
  fi

  for device in "${devices[@]}"; do
    if ! json="$(nvme smart-log -o json "$device" 2>/dev/null)"; then
      add_issue warning nvme "$device" "Unable to read NVMe SMART log" "command failed: nvme smart-log -o json $device"
      continue
    fi

    critical_warning="$(json_int "$json" '.critical_warning' || true)"
    if is_int "$critical_warning" && (( critical_warning != 0 )); then
      add_issue critical nvme "$device" "NVMe critical warning is set" "critical_warning=$critical_warning"
    fi

    available_spare="$(json_int "$json" '.avail_spare // .available_spare' || true)"
    spare_threshold="$(json_int "$json" '.spare_thresh // .available_spare_threshold' || true)"
    if is_int "$available_spare" && is_int "$spare_threshold" && (( available_spare <= spare_threshold )); then
      add_issue critical nvme "$device" "NVMe available spare is below threshold" "available_spare=$available_spare; threshold=$spare_threshold"
    fi

    percent_used="$(json_int "$json" '.percent_used // .percentage_used' || true)"
    if is_int "$percent_used"; then
      if (( percent_used >= NVME_WEAR_CRITICAL )); then
        add_issue critical nvme "$device" "NVMe endurance estimate is ${percent_used}% used" "threshold=${NVME_WEAR_CRITICAL}%"
      elif (( percent_used >= NVME_WEAR_WARNING )); then
        add_issue warning nvme "$device" "NVMe endurance estimate is ${percent_used}% used" "warning threshold=${NVME_WEAR_WARNING}%"
      fi
    fi

    media_errors="$(json_int "$json" '.media_errors' || true)"
    if is_int "$media_errors" && (( media_errors > 0 )); then
      add_issue critical nvme "$device" "NVMe media/data integrity errors reported" "media_errors=$media_errors"
    fi

    temperature="$(json_int "$json" '.temperature' || true)"
    if is_int "$temperature"; then
      temperature_c="$temperature"
      if (( temperature_c > 200 )); then
        temperature_c=$((temperature_c - 273))
      fi

      if (( temperature_c >= NVME_TEMP_CRITICAL )); then
        add_issue critical nvme "$device" "NVMe temperature is ${temperature_c}C" "critical threshold=${NVME_TEMP_CRITICAL}C"
      elif (( temperature_c >= NVME_TEMP_WARNING )); then
        add_issue warning nvme "$device" "NVMe temperature is ${temperature_c}C" "warning threshold=${NVME_TEMP_WARNING}C"
      fi
    fi
  done
}

scan_smart_health() {
  local device
  local devices=()
  local type
  local output
  local status

  while read -r device type; do
    [[ $type == disk ]] || continue
    case "$device" in
      /dev/nvme*|/dev/vd*|/dev/xvd*|/dev/loop*|/dev/ram*|/dev/zram*) continue ;;
    esac
    devices+=("$device")
  done < <(lsblk -dnpo NAME,TYPE 2>/dev/null || true)

  ((${#devices[@]} > 0)) || return 0

  if ! command -v smartctl >/dev/null 2>&1; then
    add_issue warning smart smartctl "smartmontools is missing; SATA/SCSI SMART checks skipped" "install package: smartmontools"
    return 0
  fi

  for device in "${devices[@]}"; do
    if output="$(smartctl -H "$device" 2>&1)"; then
      status=0
    else
      status=$?
    fi

    if grep -Eqi 'FAILED|failure|DISK FAILURE' <<<"$output"; then
      add_issue critical smart "$device" "SMART health check reports failure" "$(printf '%s' "$output" | tr '\n' '; ' | cut -c1-240)"
    elif (( status == 0 )) && grep -Eqi 'PASSED|OK' <<<"$output"; then
      continue
    elif grep -Eqi 'SMART support is:[[:space:]]+(Unavailable|Disabled)|Unable to detect device type|Please specify device type|Unknown USB bridge|Unsupported USB bridge' <<<"$output"; then
      continue
    elif (( status != 0 )); then
      add_issue warning smart "$device" "Unable to read SMART health" "$(printf '%s' "$output" | tr '\n' '; ' | cut -c1-240)"
    fi
  done
}

scan_failed_system_units() {
  local failed_units
  local summary

  failed_units="$(systemctl list-units --failed --no-legend --plain 2>/dev/null || true)"
  [[ -n $failed_units ]] || return 0

  summary="$(printf '%s\n' "$failed_units" | sed -n '1,5p' | tr '\n' '; ' | cut -c1-300)"
  add_issue warning systemd system "Failed systemd units are present" "$summary"
}

write_report() {
  local checked_at
  local status="ok"
  local tmp_file
  local issues_json=""

  checked_at="$(date --iso-8601=seconds 2>/dev/null || date)"
  if (( critical_count > 0 )); then
    status="critical"
  elif (( warning_count > 0 )); then
    status="warning"
  fi

  install -d -m 0755 "$STATE_DIR"
  tmp_file="$(mktemp "$STATE_DIR/health.json.XXXXXX")"

  if [[ -s $issues_file ]]; then
    issues_json="$(paste -sd, "$issues_file")"
  fi

  {
    printf '{'
    printf '"checked_at":%s,' "$(jq -Rn --arg value "$checked_at" '$value')"
    printf '"status":%s,' "$(jq -Rn --arg value "$status" '$value')"
    printf '"warning_count":%d,' "$warning_count"
    printf '"critical_count":%d,' "$critical_count"
    printf '"disk_warning_threshold":%d,' "$DISK_WARNING_THRESHOLD"
    printf '"disk_block_threshold":%d,' "$DISK_BLOCK_THRESHOLD"
    printf '"nvme_wear_warning":%d,' "$NVME_WEAR_WARNING"
    printf '"nvme_wear_critical":%d,' "$NVME_WEAR_CRITICAL"
    printf '"issues":[%s]' "$issues_json"
    printf '}\n'
  } >"$tmp_file"

  chmod 0644 "$tmp_file"
  mv "$tmp_file" "$STATE_FILE"
}

run_health_check() {
  command -v jq >/dev/null 2>&1 || {
    printf 'missing required command: jq\n' >&2
    return 1
  }

  issues_file="$(mktemp)"

  scan_disk_usage
  scan_root_read_only
  scan_nvme_health
  scan_smart_health
  scan_failed_system_units
  write_report
}

case "${1:-}" in
  "")
    run_health_check
    ;;
  --disk-space-guard)
    disk_space_guard "${2:-$DISK_BLOCK_THRESHOLD}"
    ;;
  *)
    printf 'Usage: hyprbole-health-check [--disk-space-guard [threshold]]\n' >&2
    exit 2
    ;;
esac
