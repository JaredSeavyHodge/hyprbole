#!/bin/bash

# hyprbole:summary=Mount the host-shared hyprbole repo inside a guest VM
# hyprbole:args=[mount-tag] [mount-point]

set -euo pipefail

MOUNT_TAG=${1:-hyprbole}
MOUNT_POINT=${2:-/mnt/hyprbole}

sudo mkdir -p "$MOUNT_POINT"

if mountpoint -q "$MOUNT_POINT"; then
  sudo umount "$MOUNT_POINT"
fi

sudo mount -t 9p -o trans=virtio,version=9p2000.L "$MOUNT_TAG" "$MOUNT_POINT"

printf 'Mounted %s at %s\n' "$MOUNT_TAG" "$MOUNT_POINT"
