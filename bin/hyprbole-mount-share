#!/bin/bash

# hyprbole:summary=Mount, list, or remove NAS SMB/NFS shares

set -euo pipefail

MANAGED_MARKER="# hyprbole mount-share"

ensure_commands() {
  local missing=()
  local command_name
  local package_name
  local requirement

  for requirement in "$@"; do
    command_name="${requirement%%:*}"
    package_name="${requirement#*:}"
    command -v "$command_name" >/dev/null 2>&1 || missing+=("$package_name")
  done

  if ((${#missing[@]} > 0)); then
    printf 'Installing required packages: %s\n' "${missing[*]}"
    sudo pacman -S --needed --noconfirm "${missing[@]}"
  fi
}

ensure_commands gum:gum

managed_fstab_entries() {
  grep -nF "$MANAGED_MARKER" /etc/fstab 2>/dev/null || true
}

clean_fstab_entry() {
  local content="$1"
  content="${content%%$MANAGED_MARKER*}"
  printf '%s' "$content" | xargs
}

write_managed_fstab_entry() {
  local source="$1"
  local mount_point="$2"
  local fs_type="$3"
  local options="$4"
  local tmp_file

  tmp_file=$(mktemp)
  awk -v src="$source" -v mount_point="$mount_point" -v marker="$MANAGED_MARKER" '
    $0 ~ marker {
      split($0, fields, /[[:space:]]+/)
      if (fields[1] == src || fields[2] == mount_point) next
    }
    { print }
  ' /etc/fstab >"$tmp_file"

  printf '%s  %s  %s  %s  0  0  %s\n' "$source" "$mount_point" "$fs_type" "$options" "$MANAGED_MARKER" >>"$tmp_file"
  sudo install -m 644 "$tmp_file" /etc/fstab
  rm -f "$tmp_file"
}

list_saved_shares() {
  local entries
  entries=$(managed_fstab_entries)
  if [[ -z $entries ]]; then
    printf 'No Hyprbole-managed shares found in /etc/fstab.\n'
    return
  fi
  printf 'Hyprbole-managed shares in /etc/fstab:\n\n'
  while IFS=: read -r line_num content; do
    local clean
    clean=$(clean_fstab_entry "$content")
    printf '  [%d] %s\n' "$line_num" "$clean"
  done <<< "$entries"
}

remove_share() {
  local entries
  entries=$(managed_fstab_entries)
  if [[ -z $entries ]]; then
    gum style --foreground 212 "No Hyprbole-managed shares to remove."
    return
  fi

  local lines=()
  while IFS=: read -r line_num content; do
    local clean
    clean=$(clean_fstab_entry "$content")
    lines+=("$line_num|$clean")
  done <<< "$entries"

  local choices=()
  for item in "${lines[@]}"; do
    local num label
    num="${item%%|*}"
    label="${item#*|}"
    choices+=("$num  $label")
  done

  local picked
  picked=$(gum choose --header "Select share to remove:" "${choices[@]}")
  if [[ -z $picked ]]; then
    return
  fi

  local picked_line
  picked_line="${picked%%[[:space:]]*}"
  [[ $picked_line =~ ^[0-9]+$ ]] || {
    gum style --foreground 9 "Could not parse selected fstab line."
    return 1
  }

  if gum confirm "Remove this entry from /etc/fstab?" --default=false; then
    sudo sed -i "${picked_line}d" /etc/fstab
    gum style --foreground 10 "Removed entry at line $picked_line from /etc/fstab."
  fi
}

mount_share() {
  local protocol
  protocol=$(gum choose "SMB/CIFS" "NFS" --header "Share protocol:")
  [[ -n $protocol ]] || return

  if [[ $protocol == "SMB/CIFS" ]]; then
    local server share mount_point username password

    ensure_commands mount.cifs:cifs-utils smbclient:smbclient

    server=$(gum input --placeholder "192.168.1.100" --header "Server address:")
    [[ -n $server ]] || { echo "Server required"; exit 1; }

    if gum confirm "Discover shares via smbclient?"; then
      gum spin --title "Listing shares..." -- smbclient -N -L "$server" 2>/dev/null || \
        echo "Discovery failed; enter share name manually."
    fi

    share=$(gum input --placeholder "sharename" --header "Share name:")
    [[ -n $share ]] || { echo "Share required"; exit 1; }

    mount_point=$(gum input --value "/mnt/$share" --header "Mount point:")

    if gum confirm "Connect as guest?" --default=false; then
      username=""
      password=""
    else
      username=$(gum input --header "Username:")
      password=$(gum input --password --header "Password:")
    fi

    local opts="uid=$(id -u),gid=$(id -g),iocharset=utf8,noperm"
    local creds_file=""
    if [[ -n $username ]]; then
      creds_file="/etc/smb-credentials/$share"
      sudo mkdir -p /etc/smb-credentials
      sudo chmod 700 /etc/smb-credentials
      printf 'username=%s\npassword=%s\n' "$username" "$password" | sudo tee "$creds_file" >/dev/null
      sudo chmod 600 "$creds_file"
      opts="$opts,credentials=$creds_file"
    else
      opts="$opts,guest"
    fi

    sudo mkdir -p "$mount_point"
    if gum spin --title "Mounting..." -- sudo mount -t cifs "//$server/$share" "$mount_point" -o "$opts"; then
      gum style --foreground 10 "Mounted //$server/$share at $mount_point"
    else
      gum style --foreground 9 "Mount failed"
      exit 1
    fi

    if gum confirm "Add to /etc/fstab for automatic mounting?"; then
      local fstab_opts="$opts,nofail,x-systemd.automount,x-systemd.mount-timeout=30,_netdev"
      write_managed_fstab_entry "//$server/$share" "$mount_point" cifs "$fstab_opts"
      gum style --foreground 10 "Saved /etc/fstab entry with nofail and systemd automount."
    fi
  fi

  if [[ $protocol == "NFS" ]]; then
    local server export_path mount_point

    ensure_commands mount.nfs:nfs-utils

    server=$(gum input --placeholder "192.168.1.100" --header "Server address:")
    [[ -n $server ]] || { echo "Server required"; exit 1; }

    export_path=$(gum input --placeholder "/srv/nfs/share" --header "Export path:")
    [[ -n $export_path ]] || { echo "Export path required"; exit 1; }

    mount_point=$(gum input --value "/mnt/$(basename "$export_path")" --header "Mount point:")

    sudo mkdir -p "$mount_point"
    if gum spin --title "Mounting..." -- sudo mount -t nfs "$server:$export_path" "$mount_point"; then
      gum style --foreground 10 "Mounted $server:$export_path at $mount_point"
    else
      gum style --foreground 9 "Mount failed"
      exit 1
    fi

    if gum confirm "Add to /etc/fstab for automatic mounting?"; then
      local fstab_opts="nofail,x-systemd.automount,x-systemd.mount-timeout=30,_netdev"
      write_managed_fstab_entry "$server:$export_path" "$mount_point" nfs "$fstab_opts"
      gum style --foreground 10 "Saved /etc/fstab entry with nofail and systemd automount."
    fi
  fi
}

action=$(gum choose "Mount a share" "List saved shares" "Remove a saved share" --header "NAS Share Manager:")

case $action in
  "Mount a share")
    mount_share
    ;;
  "List saved shares")
    list_saved_shares
    printf '\nPress Enter to exit...'
    read -r _
    ;;
  "Remove a saved share")
    remove_share
    printf '\nPress Enter to exit...'
    read -r _
    ;;
esac
