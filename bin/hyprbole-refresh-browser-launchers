#!/bin/bash

# hyprbole:summary=Refresh browser launchers, flags, and suppress unwanted desktop entries

set -euo pipefail

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
HYPRBOLE_CONFIG_PATH="${HYPRBOLE_CONFIG_PATH:-$XDG_CONFIG_HOME/hyprbole}"
HYPRBOLE_PATH="${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}"
APPLICATIONS_DIR="$HOME/.local/share/applications"
BRAVE_FLAGS_FILE="$XDG_CONFIG_HOME/brave-origin-nightly-flags.conf"
HIDDEN_ENTRIES_SOURCE="$HYPRBOLE_PATH/default/hyprbole/hidden-desktop-entries"

ensure_brave_flags() {
  local flag
  local extra_flags=()

  mkdir -p "$(dirname "$BRAVE_FLAGS_FILE")"

  if [[ -f $BRAVE_FLAGS_FILE ]]; then
    while IFS= read -r flag || [[ -n $flag ]]; do
      flag="${flag%%#*}"
      flag="${flag#"${flag%%[![:space:]]*}"}"
      flag="${flag%"${flag##*[![:space:]]}"}"
      [[ -n $flag ]] || continue
      [[ $flag == --password-store=gnome-libsecret ]] && continue
      [[ $flag == --ozone-platform-hint=auto ]] && continue
      extra_flags+=("$flag")
    done <"$BRAVE_FLAGS_FILE"
  fi

  {
    printf '%s\n' '--password-store=gnome-libsecret'
    printf '%s\n' '--ozone-platform-hint=auto'
    for flag in "${extra_flags[@]}"; do
      printf '%s\n' "$flag"
    done
  } >"$BRAVE_FLAGS_FILE"
}

cleanup_old_brave_desktop() {
  local old="$APPLICATIONS_DIR/hyprbole-brave-origin-nightly.desktop"

  if [[ -f $old ]]; then
    rm -f "$old"
  fi
}

set_default_browser() {
  xdg-settings set default-web-browser brave-origin-nightly.desktop >/dev/null 2>&1 || true
  xdg-mime default brave-origin-nightly.desktop text/html >/dev/null 2>&1 || true
  xdg-mime default brave-origin-nightly.desktop x-scheme-handler/http >/dev/null 2>&1 || true
  xdg-mime default brave-origin-nightly.desktop x-scheme-handler/https >/dev/null 2>&1 || true
}

suppress_unwanted_entries() {
  local entry

  mkdir -p "$APPLICATIONS_DIR"

  if [[ -d $HIDDEN_ENTRIES_SOURCE ]]; then
    for entry in "$HIDDEN_ENTRIES_SOURCE"/*.desktop; do
      [[ -f $entry ]] || continue
      cp "$entry" "$APPLICATIONS_DIR/"
    done
  fi
}

ensure_brave_flags
cleanup_old_brave_desktop
set_default_browser
suppress_unwanted_entries
