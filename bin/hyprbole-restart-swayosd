#!/bin/bash

# hyprbole:summary=Restart SwayOSD server

set -euo pipefail

systemctl --user daemon-reload
systemctl --user stop swayosd-server.service >/dev/null 2>&1 || true
pkill -x swayosd-server >/dev/null 2>&1 || true
systemctl --user reset-failed swayosd-server.service >/dev/null 2>&1 || true
systemctl --user enable --now swayosd-server.service
