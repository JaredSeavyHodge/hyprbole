#!/bin/bash

# hyprbole:summary=Print Waybar JSON for cached update health state
# hyprbole:args=[--has-updates]

set -euo pipefail

STATE_FILE="${HYPRBOLE_HEALTH_STATE_FILE:-/var/lib/hyprbole/health.json}"
UPDATE_ICON="󰚰"

has_update_issues() {
  [[ -f $STATE_FILE ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  jq -e '[.issues[]? | select(.category == "updates" and .target == "pacman" and (.message | test("full package update")))] | length > 0' "$STATE_FILE" >/dev/null 2>&1
}

emit() {
  local checked_at
  local tooltip

  checked_at="$(jq -r '.checked_at // "unknown"' "$STATE_FILE" 2>/dev/null || printf 'unknown\n')"
  tooltip="$(jq -r '[.issues[]? | select(.category == "updates" and .target == "pacman" and (.message | test("full package update"))) | .message][0:4][]' "$STATE_FILE" 2>/dev/null || true)"
  if [[ -z $tooltip ]]; then
    tooltip="Updates recommended"
  fi
  tooltip="Updates recommended\nChecked: $checked_at\n$tooltip"

  jq -cn --arg text "$UPDATE_ICON" --arg tooltip "$tooltip" '{text: $text, class: "recommended", tooltip: $tooltip}'
}

case "${1:-}" in
  "")
    if has_update_issues; then
      emit
    fi
    ;;
  --has-updates)
    has_update_issues
    ;;
  *)
    printf 'Usage: hyprbole-update-indicator [--has-updates]\n' >&2
    exit 2
    ;;
esac
