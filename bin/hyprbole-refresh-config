#!/bin/bash

# hyprbole:summary=Refresh one config from shipped defaults
# hyprbole:args=<path>

set -euo pipefail

source "${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}/bin/hyprbole-lib"

relative_path=${1:-}
[[ -n $relative_path ]] || {
  printf 'Usage: hyprbole-refresh-config <path>\n' >&2
  exit 1
}

hyprbole_refresh_config_path "$relative_path"
