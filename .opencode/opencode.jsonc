{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "openai/gpt-5.4-mini-fast",
  "command": {
    "review-runtime": {
      "description": "Review Rust shell runtime workflows",
      "agent": "runtime-flow-reviewer",
      "template": "Review the current Hyprbole Rust shell runtime changes. Inspect only changed files and directly referenced helpers/configs needed to validate behavior. Focus on crates/hyprbole-shell-*, shell IPC/action/state behavior, UI launch behavior, and shell architecture consistency. Return prioritized findings with file/line references; if none, say so briefly. Do not edit files."
    },
    "review-docs": {
      "description": "Review shell docs for drift",
      "agent": "docs-sync-reviewer",
      "template": "Review Hyprbole Shell documentation for drift against current implementation. Inspect only changed docs and directly related implementation/docs needed to verify drift. Focus on README.md, docs/architecture.md, docs/shell-architecture.md, docs/implementation-plan.md, and AGENTS.md when relevant. Return prioritized findings with file/line references; if none, say so briefly. Do not edit files."
    }
  },
  "agent": {
    "explore": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "general": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "title": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "summary": {
      "model": "openai/gpt-5.4-mini-fast"
    },
    "compaction": {
      "model": "openai/gpt-5.4-mini-fast"
    }
  }
}
