HYPRBOLE_PATH="${HYPRBOLE_PATH:-$HOME/.local/share/hyprbole}"

source "$HYPRBOLE_PATH/default/bash/envs"
source "$HYPRBOLE_PATH/default/bash/shell"
source "$HYPRBOLE_PATH/default/bash/aliases"
source "$HYPRBOLE_PATH/default/bash/functions"
source "$HYPRBOLE_PATH/default/bash/init"
[[ $- == *i* ]] && [[ -f $HYPRBOLE_PATH/default/bash/inputrc ]] && bind -f "$HYPRBOLE_PATH/default/bash/inputrc"
