# Editor used by CLI
export SUDO_EDITOR="$EDITOR"
export BAT_THEME=ansi

# Color man pages with bat
export MANROFFOPT="-c"
export MANPAGER="sh -c 'col -bx | bat -l man -p'"

# Shared shell path and runtime env
export HYPRBOLE_PATH="$HOME/.local/share/hyprbole"
export PATH="$HYPRBOLE_PATH/bin:$PATH:$HOME/.local/bin"
